---
interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  centered?: boolean;
  light?: boolean;
  reveal?: string;
  delay?: number;
}

const { title, subtitle, tag, centered = true, light = false, reveal = 'fade-up', delay = 0 } = Astro.props;
---

<div class:list={['mb-14 lg:mb-20', centered && 'text-center']} data-reveal={reveal} data-delay={String(delay)}>
  {/* Optional tag with decorative dot */}
  {tag && (
    <div class:list={['flex items-center gap-2.5 mb-5', centered && 'justify-center']}>
      <span class="relative flex items-center gap-2">
        {/* Animated decorative dots */}
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-cyan opacity-50"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-cyan"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-accent-cyan bg-accent-cyan/10 border border-accent-cyan/20 px-3 py-1 rounded-full">
          {tag}
        </span>
      </span>
    </div>
  )}

  {/* Decorative accent line above heading when no tag */}
  {!tag && (
    <div class:list={['flex items-center gap-3 mb-6', centered && 'justify-center']}>
      <div class="w-8 h-[2px] bg-gradient-to-r from-accent-cyan to-transparent rounded-full"></div>
      <div class="w-2 h-2 rounded-full bg-accent-violet"></div>
      <div class="w-8 h-[2px] bg-gradient-to-l from-accent-amber to-transparent rounded-full"></div>
    </div>
  )}

  {/* Main heading with enhanced gradient */}
  <h2 class:list={[
    'heading-display text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] mb-5',
  ]}>
    <span class="gradient-text">{title}</span>
  </h2>

  {subtitle && (
    <p class:list={[
      'text-lg max-w-2xl leading-relaxed',
      centered && 'mx-auto',
      light ? 'text-ink-300' : 'text-ink-400',
    ]}>
      {subtitle}
    </p>
  )}

  {/* Enhanced decorative underline */}
  <div class:list={['mt-7 flex items-center gap-2', centered && 'justify-center']}>
    <div class="w-10 h-1 bg-gradient-to-r from-accent-cyan to-brand-500 rounded-full"></div>
    <div class="w-3 h-1 bg-accent-violet rounded-full"></div>
    <div class="w-6 h-1 bg-gradient-to-r from-accent-amber to-transparent rounded-full"></div>
  </div>
</div>
