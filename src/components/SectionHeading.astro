---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = true, light = false } = Astro.props;
---

<div class:list={['mb-12 lg:mb-16', centered && 'text-center']}>
  <h2 class:list={[
    'font-display font-bold text-3xl sm:text-4xl lg:text-5xl mb-4',
    light ? 'text-white' : 'text-white',
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      'text-lg max-w-2xl leading-relaxed',
      centered && 'mx-auto',
      light ? 'text-dark-300' : 'text-dark-400',
    ]}>
      {subtitle}
    </p>
  )}
  <div class:list={[
    'w-20 h-1 bg-accent-gradient rounded-full mt-6',
    centered && 'mx-auto',
  ]}></div>
</div>
