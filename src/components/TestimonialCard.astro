---
interface Props {
  name: string;
  role: string;
  company: string;
  content: string;
  rating: number;
  reveal?: string;
  delay?: number;
}

const { name, role, company, content, rating, reveal, delay } = Astro.props;
const revealAttrs: Record<string, string> = {};
if (reveal) revealAttrs['data-reveal'] = reveal;
if (delay !== undefined) revealAttrs['data-delay'] = String(delay);

// Generate a unique gradient for each avatar based on name
const avatarGradients = [
  'from-accent-cyan via-brand-400 to-accent-violet',
  'from-accent-violet via-brand-500 to-accent-cyan',
  'from-accent-amber via-accent-cyan to-brand-400',
  'from-brand-400 via-accent-violet to-accent-amber',
  'from-accent-cyan to-accent-amber',
  'from-accent-violet to-accent-cyan',
];

let nameHash = 0;
for (let i = 0; i < name.length; i++) {
  nameHash = name.charCodeAt(i) + ((nameHash << 5) - nameHash);
}
const avatarGradient = avatarGradients[Math.abs(nameHash) % avatarGradients.length];
---

<div class="relative p-6 lg:p-8 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1" style="background: rgba(var(--card-bg), 0.6); backdrop-filter: blur(24px); border: 1px solid rgba(var(--card-border), 0.4);" {...revealAttrs}>
  {/* Gradient border accent -- top edge */}
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-accent-cyan via-accent-violet to-accent-amber"></div>

  {/* Decorative glow behind quote */}
  <div class="absolute top-4 left-4 w-32 h-32 bg-accent-violet/5 rounded-full blur-2xl pointer-events-none"></div>

  {/* Stars - stagger light up on hover */}
  <div class="star-stagger flex gap-1.5 mb-5">
    {Array.from({ length: rating }).map((_, i) => (
      <svg class="w-5 h-5 drop-shadow-sm" viewBox="0 0 20 20" style={`filter: drop-shadow(0 0 4px rgba(245,158,11,0.4));`}>
        <defs>
          <linearGradient id={`star-grad-${name.replace(/\s/g, '')}-${i}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f59e0b"/>
            <stop offset="100%" stop-color="#fbbf24"/>
          </linearGradient>
        </defs>
        <path fill={`url(#star-grad-${name.replace(/\s/g, '')}-${i})`} d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    ))}
  </div>

  {/* Large decorative gradient quote mark - float animation */}
  <div class="relative mb-4">
    <svg class="quote-float w-16 h-16 absolute -top-3 -left-2 opacity-20" viewBox="0 0 24 24" fill="none">
      <defs>
        <linearGradient id={`quote-grad-${name.replace(/\s/g, '')}`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#06b6d4"/>
          <stop offset="50%" stop-color="#8b5cf6"/>
          <stop offset="100%" stop-color="#f59e0b"/>
        </linearGradient>
      </defs>
      <path fill={`url(#quote-grad-${name.replace(/\s/g, '')})`} d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10H0z"/>
    </svg>
    <blockquote class="relative z-10 pl-2 pt-6">
      <p class="text-ink-200 leading-relaxed text-[15px]">{content}</p>
    </blockquote>
  </div>

  {/* Author */}
  <div class="flex items-center gap-3.5 mt-6 pt-5 border-t border-surface-4/50">
    <div class:list={['avatar-ring-hover relative w-11 h-11 rounded-full bg-gradient-to-br flex items-center justify-center text-ink-100 font-bold text-sm shrink-0', avatarGradient]}>
      {name.split(' ').map((n) => n[0]).join('')}
      {/* Ring accent */}
      <div class="absolute inset-0 rounded-full ring-2 ring-white/10"></div>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink-100">{name}</p>
      <p class="text-xs text-ink-400 mt-0.5">{role}, <span class="text-brand-400">{company}</span></p>
    </div>
  </div>
</div>
