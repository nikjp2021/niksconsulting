---
const navLinks = [
  { href: '/', label: 'Home', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  {
    label: 'Services',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
    children: [
      { href: '/services', label: 'Our Services' },
      { href: '/case-studies', label: 'Case Studies' },
    ],
  },
  {
    label: 'Training',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    children: [
      { href: '/training', label: 'AI Training' },
      { href: '/gifted', label: 'Gifted Internship' },
    ],
  },
  { href: '/about', label: 'About', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
  { href: '#blog-coming-soon', label: 'Blog', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
  { href: '/contact', label: 'Contact', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
];

const currentPath = Astro.url.pathname;

function isActiveLink(link: any): boolean {
  if (link.href) return currentPath === link.href;
  if (link.children) return link.children.some((c: any) => currentPath === c.href);
  return false;
}
---

<header class="fixed top-0 left-0 right-0 z-50 navbar-expanded" style="">
  <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-accent-cyan/40 to-transparent"></div>

  <nav class="nav-inner container-custom flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="relative">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-accent-cyan via-brand-500 to-accent-violet flex items-center justify-center font-display font-extrabold text-white text-lg shadow-glow-sm group-hover:shadow-glow-md transition-shadow duration-300">
          N
        </div>
        <div class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-accent-amber opacity-80 group-hover:opacity-100 transition-opacity"></div>
      </div>
      <span class="font-display font-bold text-lg text-ink-100 group-hover:text-ink-100 transition-colors">
        Nik's <span class="text-brand-400">Consulting</span>
      </span>
    </a>

    {/* Desktop Nav */}
    <div class="hidden lg:flex items-center gap-0.5">
      {navLinks.map((link) => {
        const active = isActiveLink(link);

        if (link.children) {
          return (
            <div class="relative group/dropdown">
              <button
                class:list={[
                  'relative flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-300',
                  active ? 'text-ink-100' : 'text-ink-400 hover:text-ink-100',
                ]}
              >
                {active && (
                  <span class="absolute inset-0 rounded-lg bg-brand-500/10 border border-brand-500/15"></span>
                )}
                <span class="relative z-10 flex items-center gap-1">
                  {link.label}
                  <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-200 group-hover/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </button>

              <div class="absolute top-full left-0 pt-1 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 translate-y-1 group-hover/dropdown:translate-y-0">
                <div class="w-48 py-2 rounded-xl border border-surface-4/50 shadow-xl" style="background: var(--mobile-menu-bg); backdrop-filter: blur(24px);">
                  {link.children.map((child: any) => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm font-medium transition-all duration-200',
                        currentPath === child.href
                          ? 'text-brand-400 bg-brand-500/10'
                          : 'text-ink-300 hover:text-ink-100 hover:bg-surface-3',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        }

        return (
          <a
            href={link.href}
            class:list={[
              'relative px-3 py-2 rounded-lg text-sm font-medium transition-all duration-300',
              active ? 'text-ink-100' : 'text-ink-400 hover:text-ink-100',
            ]}
          >
            {active && (
              <span class="absolute inset-0 rounded-lg bg-brand-500/10 border border-brand-500/15"></span>
            )}
            <span class="relative z-10">
              {link.label}
            </span>
          </a>
        );
      })}
    </div>

    {/* CTA + Theme Toggle */}
    <div class="hidden lg:flex items-center gap-3">
      <button
        id="theme-toggle"
        class="p-2 rounded-lg text-ink-400 hover:text-ink-100 hover:bg-surface-3 transition-all duration-200"
        aria-label="Toggle theme"
      >
        <svg id="icon-sun" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg id="icon-moon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>
      <a href="/get-a-quote" class="btn-primary text-sm shadow-glow-sm hover:shadow-glow-md">
        Get a Quote
      </a>
    </div>

    {/* Mobile Menu Button */}
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2.5 rounded-lg text-ink-200 hover:text-ink-100 hover:bg-surface-3/50 transition-all duration-200"
      aria-label="Toggle menu"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  {/* Mobile Menu Overlay */}
  <div id="mobile-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden lg:hidden" aria-hidden="true"></div>

  {/* Mobile Menu Panel */}
  <div id="mobile-menu" class="fixed top-0 right-0 bottom-0 w-[min(85vw,320px)] z-50 hidden lg:hidden overflow-y-auto overscroll-contain" style="background: var(--mobile-menu-bg); backdrop-filter: blur(32px); border-left: 1px solid rgba(var(--card-border), 0.5);">
    {/* Menu Header */}
    <div class="flex items-center justify-between px-5 py-4 border-b border-surface-4/30">
      <span class="font-display font-bold text-ink-100">Menu</span>
      <button id="mobile-close-btn" class="p-2 rounded-lg text-ink-300 hover:text-ink-100 hover:bg-surface-3/50 transition-all" aria-label="Close menu">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {/* Menu Links */}
    <div class="px-3 py-4 space-y-1">
      {navLinks.map((link) => {
        const active = isActiveLink(link);

        if (link.children) {
          return (
            <div class="mb-2">
              <div class:list={[
                'flex items-center gap-3 px-3 py-3 rounded-xl text-xs font-semibold uppercase tracking-wider',
                active ? 'text-brand-400' : 'text-ink-300',
              ]}>
                <svg class="w-5 h-5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={link.icon} />
                {link.label}
              </div>
              <div class="ml-4 mt-1 space-y-0.5 border-l-2 border-surface-4/30 pl-3">
                {link.children.map((child: any) => (
                  <a
                    href={child.href}
                    class:list={[
                      'flex items-center gap-2 px-3 py-3 rounded-xl text-sm font-medium transition-all duration-200',
                      currentPath === child.href
                        ? 'text-brand-300 bg-brand-500/15 font-semibold'
                        : 'text-ink-200 hover:text-ink-100 hover:bg-surface-3/50',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a
            href={link.href}
            class:list={[
              'flex items-center gap-3 px-3 py-3 rounded-xl text-sm font-medium transition-all duration-200',
              active
                ? 'text-brand-300 bg-brand-500/15 font-semibold'
                : 'text-ink-200 hover:text-ink-100 hover:bg-surface-3/50',
            ]}
          >
            <svg class="w-5 h-5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={link.icon} />
            {link.label}
          </a>
        );
      })}
    </div>

    {/* Menu Footer */}
    <div class="px-3 pb-6 space-y-3 border-t border-surface-4/30 pt-4 mt-2">
      <button
        id="theme-toggle-mobile"
        class="flex items-center gap-3 w-full px-3 py-3 rounded-xl text-sm font-medium text-ink-200 hover:text-ink-100 hover:bg-surface-3/50 transition-all"
        aria-label="Toggle theme"
      >
        <svg id="icon-sun-mobile" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg id="icon-moon-mobile" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
        <span>Switch Theme</span>
      </button>
      <a href="/get-a-quote" class="btn-primary w-full text-sm text-center py-3.5">
        Get a Quote
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const closeBtn = document.getElementById('mobile-close-btn');

  function openMenu() {
    menu?.classList.remove('hidden');
    overlay?.classList.remove('hidden');
    menuIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    overlay?.classList.add('hidden');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    isOpen ? closeMenu() : openMenu();
  });

  overlay?.addEventListener('click', closeMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'escape') closeMenu();
  });

  // Close on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) closeMenu();
  });

  // Theme toggle
  function updateThemeIcons(isLight: boolean) {
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    const sunMobile = document.getElementById('icon-sun-mobile');
    const moonMobile = document.getElementById('icon-moon-mobile');

    if (isLight) {
      sun?.classList.add('hidden');
      moon?.classList.remove('hidden');
      sunMobile?.classList.add('hidden');
      moonMobile?.classList.remove('hidden');
    } else {
      sun?.classList.remove('hidden');
      moon?.classList.add('hidden');
      sunMobile?.classList.remove('hidden');
      moonMobile?.classList.add('hidden');
    }
  }

  const currentIsLight = document.documentElement.classList.contains('light');
  updateThemeIcons(currentIsLight);

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateThemeIcons(isLight);
  });

  document.getElementById('theme-toggle-mobile')?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateThemeIcons(isLight);
  });
</script>
