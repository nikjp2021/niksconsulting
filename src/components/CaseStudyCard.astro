---
interface Props {
  title: string;
  client: string;
  location: string;
  challenge: string;
  results: string[];
  tags: string[];
  href: string;
}

const { title, client, location, challenge, results, tags, href } = Astro.props;
---

<a href={href} class="group glass-card-hover overflow-hidden block">
  <!-- Image Placeholder -->
  <div class="h-48 bg-gradient-to-br from-primary-500/20 to-accent-500/20 relative overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center">
      <svg class="w-16 h-16 text-primary-400/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
    <!-- REPLACE: Add actual project screenshot -->
    <!-- <img src="/images/case-study.jpg" alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" /> -->
    <div class="absolute bottom-3 left-3 flex gap-2">
      {tags.map((tag) => (
        <span class="px-2 py-1 bg-dark-900/80 backdrop-blur-sm rounded-md text-xs text-primary-300 font-medium">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <div class="p-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs text-accent-400 font-medium">{location}</span>
      <span class="w-1 h-1 bg-dark-600 rounded-full"></span>
      <span class="text-xs text-dark-500">{client}</span>
    </div>
    <h3 class="font-display font-semibold text-lg text-white mb-3 group-hover:text-primary-300 transition-colors">
      {title}
    </h3>
    <p class="text-sm text-dark-400 leading-relaxed mb-4 line-clamp-3">
      {challenge}
    </p>
    <div class="space-y-2">
      {results.slice(0, 2).map((result) => (
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="text-xs text-dark-300">{result}</span>
        </div>
      ))}
    </div>
  </div>
</a>
