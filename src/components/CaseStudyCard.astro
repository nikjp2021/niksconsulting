---
interface Props {
  title: string;
  client: string;
  location: string;
  challenge: string;
  results: string[];
  tags: string[];
  href: string;
  reveal?: string;
  delay?: number;
}

const { title, client, location, challenge, results, tags, href, reveal, delay } = Astro.props;
const revealAttrs: Record<string, string> = {};
if (reveal) revealAttrs['data-reveal'] = reveal;
if (delay !== undefined) revealAttrs['data-delay'] = String(delay);

// Assign a unique color per tag based on tag name hash
const tagColors = [
  { bg: 'bg-accent-cyan/15', text: 'text-accent-cyan', border: 'border-accent-cyan/25' },
  { bg: 'bg-accent-violet/15', text: 'text-accent-violet', border: 'border-accent-violet/25' },
  { bg: 'bg-accent-amber/15', text: 'text-accent-amber', border: 'border-accent-amber/25' },
  { bg: 'bg-brand-400/15', text: 'text-brand-300', border: 'border-brand-400/25' },
];

function getTagColor(tag: string) {
  let hash = 0;
  for (let i = 0; i < tag.length; i++) {
    hash = tag.charCodeAt(i) + ((hash << 5) - hash);
  }
  return tagColors[Math.abs(hash) % tagColors.length];
}
---

<a href={href} class="group case-study-glow-border block overflow-hidden rounded-2xl transition-all duration-300 hover:-translate-y-1" style="background: rgba(var(--card-bg), 0.6); backdrop-filter: blur(24px); border: 1px solid rgba(var(--card-border), 0.4);" {...revealAttrs}>
  {/* Gradient mesh image area */}
  <div class="h-52 relative overflow-hidden">
    {/* Multi-layer gradient mesh background */}
    <div class="absolute inset-0 case-study-img-zoom" style="background: radial-gradient(ellipse at 20% 30%, rgba(6,182,212,0.25) 0%, transparent 55%), radial-gradient(ellipse at 80% 20%, rgba(139,92,246,0.2) 0%, transparent 50%), radial-gradient(ellipse at 50% 80%, rgba(245,158,11,0.12) 0%, transparent 50%), linear-gradient(135deg, rgba(var(--surface-2), 0.9) 0%, rgba(var(--surface-1), 0.95) 100%);"></div>

    {/* View Case Study button on hover */}
    <div class="case-study-center-btn absolute inset-0 flex items-center justify-center z-10">
      <span class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-accent-cyan to-accent-violet !text-white text-sm font-bold shadow-lg shadow-accent-cyan/20">
        View Case Study
      </span>
    </div>

    {/* Decorative SVG illustration placeholder */}
    <div class="absolute inset-0 flex items-center justify-center">
      <svg class="w-28 h-28 opacity-[0.12] group-hover:opacity-[0.2] group-hover:scale-110 transition-all duration-500" viewBox="0 0 120 120" fill="none">
        {/* Abstract geometric pattern */}
        <circle cx="60" cy="60" r="50" stroke="url(#caseGrad1)" stroke-width="1" opacity="0.6"/>
        <circle cx="60" cy="60" r="35" stroke="url(#caseGrad2)" stroke-width="1" opacity="0.4"/>
        <circle cx="60" cy="60" r="20" stroke="url(#caseGrad1)" stroke-width="1.5" opacity="0.8"/>
        <line x1="10" y1="60" x2="110" y2="60" stroke="url(#caseGrad2)" stroke-width="0.5" opacity="0.3"/>
        <line x1="60" y1="10" x2="60" y2="110" stroke="url(#caseGrad1)" stroke-width="0.5" opacity="0.3"/>
        <rect x="40" y="40" width="40" height="40" rx="8" stroke="url(#caseGrad2)" stroke-width="1" opacity="0.5" transform="rotate(45 60 60)"/>
        <defs>
          <linearGradient id="caseGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#06b6d4"/>
            <stop offset="100%" stop-color="#8b5cf6"/>
          </linearGradient>
          <linearGradient id="caseGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#8b5cf6"/>
            <stop offset="100%" stop-color="#f59e0b"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    {/* Subtle grid overlay */}
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 24px 24px;"></div>

    {/* Tags with unique colors - slide up on hover */}
    <div class="case-study-tags absolute bottom-3 left-3 flex flex-wrap gap-2">
      {tags.map((tag) => {
        const tc = getTagColor(tag);
        return (
          <span class:list={['px-2.5 py-1 backdrop-blur-md rounded-lg text-xs font-semibold border', tc.bg, tc.text, tc.border]}>
            {tag}
          </span>
        );
      })}
    </div>

    {/* Corner accent */}
    <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-gradient-to-br from-accent-cyan/20 to-accent-violet/20 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <svg class="w-4 h-4 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </div>
  </div>

  <div class="p-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs font-semibold bg-accent-cyan/10 text-accent-cyan px-2 py-0.5 rounded-md">{location}</span>
      <span class="w-1.5 h-1.5 bg-surface-5 rounded-full"></span>
      <span class="text-xs text-ink-400">{client}</span>
    </div>
    <h3 class="font-display font-semibold text-lg text-ink-100 mb-3 group-hover:text-accent-cyan transition-colors duration-300">
      {title}
    </h3>
    <p class="text-sm text-ink-400 leading-relaxed mb-5 line-clamp-3">
      {challenge}
    </p>
    <div class="space-y-2.5">
      {results.slice(0, 2).map((result) => (
        <div class="flex items-start gap-2.5">
          <div class="w-5 h-5 rounded-full bg-brand-500/15 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3 h-3 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-xs text-ink-300 leading-relaxed">{result}</span>
        </div>
      ))}
    </div>
  </div>
</a>
