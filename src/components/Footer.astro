---
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { href: '/services#ai-solutions', label: 'AI Solutions & Agentic AI' },
    { href: '/services#ai-automation', label: 'AI Automation' },
    { href: '/services#digital-transformation', label: 'Digital Transformation' },
    { href: '/services#website-development', label: 'Website & App Development' },
    { href: '/services#ai-social-media', label: 'AI-Powered Social Media' },
    { href: '/services#agile-management', label: 'Agile Project Management' },
  ],
  company: [
    { href: '/about', label: 'About Us' },
    { href: '/case-studies', label: 'Case Studies' },
    { href: '/gifted', label: 'Gifted Internship' },
    { href: '/training', label: 'AI Training' },
    { href: '/contact', label: 'Contact' },
    { href: '/get-a-quote', label: 'Get a Quote' },
    { href: 'https://blog.niksconsulting.com', label: 'Blog', external: true },
  ],
};

const socials = [
  { href: 'https://www.linkedin.com/in/ntiwari1', label: 'LinkedIn', color: 'hover:bg-[#0077b5]/15 hover:text-[#0077b5] hover:border-[#0077b5]/30', icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>' },
  { href: '#', label: 'Facebook', color: 'hover:bg-[#1877f2]/15 hover:text-[#1877f2] hover:border-[#1877f2]/30', icon: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>' },
  { href: '#', label: 'YouTube', color: 'hover:bg-[#ff0000]/15 hover:text-[#ff0000] hover:border-[#ff0000]/30', icon: '<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>' },
  { href: 'https://x.com/niksconsulting', label: 'X (Twitter)', color: 'hover:bg-ink-100/10 hover:text-ink-100 hover:border-ink-100/20', icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>' },
];
---

<footer class="relative overflow-hidden" style="background: var(--footer-bg); border-top: 1px solid rgba(var(--card-border), 0.4);">
  {/* Decorative gradient orb -- top left */}
  <div class="absolute -top-32 -left-32 w-64 h-64 rounded-full bg-accent-cyan/[0.04] blur-3xl pointer-events-none"></div>
  {/* Decorative gradient orb -- bottom right */}
  <div class="absolute -bottom-24 -right-24 w-56 h-56 rounded-full bg-accent-amber/[0.05] blur-3xl pointer-events-none"></div>

  <div class="container-custom section-padding !py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      {/* Brand + Newsletter */}
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-accent-cyan via-brand-500 to-accent-violet flex items-center justify-center font-display font-extrabold text-ink-100 text-lg shadow-glow-sm">
            N
          </div>
          <span class="font-display font-bold text-lg text-ink-100">
            Nik's <span class="bg-gradient-to-r from-accent-cyan to-accent-violet bg-clip-text text-transparent">Consulting</span>
          </span>
        </a>
        <p class="text-ink-400 text-sm leading-relaxed mb-6">
          Pioneers in AI Solutions & Innovation. We deliver AI-powered solutions, agentic workflows, and digital transformation for startups and SMEs.
        </p>

        {/* Newsletter visual element */}
        <div class="rounded-xl p-4 mb-6" style="background: linear-gradient(135deg, rgba(20,184,166,0.08), rgba(6,182,212,0.06)); border: 1px solid rgba(20,184,166,0.15);">
          <p class="text-xs font-semibold text-brand-400 mb-1.5">Stay Updated</p>
          <p class="text-xs text-ink-400 mb-3">Get AI insights delivered to your inbox.</p>
          <div class="flex gap-2">
            <input type="email" placeholder="your@email.com" class="input-field !px-3 !py-2 !text-xs !rounded-lg" />
            <button class="px-3 py-2 text-xs font-semibold bg-brand-500 !text-white rounded-lg hover:bg-brand-400 transition-all duration-300 shrink-0">
              Join
            </button>
          </div>
        </div>

        {/* Social icons with brand colors on hover */}
        <div class="flex gap-2.5">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class:list={['w-10 h-10 rounded-xl bg-surface-3 border border-surface-4 flex items-center justify-center text-ink-400 transition-all duration-300', s.color]} aria-label={s.label}>
              <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24" set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      {/* Services Links */}
      <div>
        <h4 class="font-display font-semibold text-ink-100 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan"></span>
          Services
        </h4>
        <ul class="space-y-3">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-400 hover:text-accent-cyan transition-colors duration-200 flex items-center gap-2 group/link">
                <span class="w-0 group-hover/link:w-2 h-[1px] bg-accent-cyan transition-all duration-200"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Company Links */}
      <div>
        <h4 class="font-display font-semibold text-ink-100 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Company
        </h4>
        <ul class="space-y-3">
          {footerLinks.company.map((link) => (
            <li>
              <a
                href={link.external ? 'https://blog.niksconsulting.com' : link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-sm text-ink-400 hover:text-emerald-400 transition-colors duration-200 flex items-center gap-2 group/link"
              >
                <span class="w-0 group-hover/link:w-2 h-[1px] bg-emerald-400 transition-all duration-200"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Contact Info */}
      <div>
        <h4 class="font-display font-semibold text-ink-100 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-amber"></span>
          Get in Touch
        </h4>
        <ul class="space-y-3.5">
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-accent-cyan/10 border border-accent-cyan/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <a href="mailto:info@niksconsulting.com" class="text-sm text-ink-400 hover:text-accent-cyan transition-colors">
              info@niksconsulting.com
            </a>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-400/10 border border-emerald-400/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <a href="tel:+1234567890" class="text-sm text-ink-400 hover:text-emerald-400 transition-colors">
              +1 (234) 567-890
            </a>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-accent-amber/10 border border-accent-amber/15 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-accent-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-sm text-ink-400">
              Your City, Country
            </span>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="mt-12 pt-8 border-t border-surface-4/50 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-ink-500">
        &copy; {currentYear} Nik's Consulting. All rights reserved.
      </p>
      <p class="text-sm text-ink-500">
        Built with passion by <a href="/" class="text-brand-400 hover:text-brand-300 transition-colors">Nik's Consulting</a>
      </p>
    </div>
  </div>
</footer>
