---
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { href: '/services#ai-solutions', label: 'AI Solutions & Agentic AI' },
    { href: '/services#ai-automation', label: 'AI Automation' },
    { href: '/services#digital-transformation', label: 'Digital Transformation' },
    { href: '/services#website-development', label: 'Website & App Development' },
    { href: '/services#ai-social-media', label: 'AI-Powered Social Media' },
    { href: '/services#agile-management', label: 'Agile Project Management' },
  ],
  company: [
    { href: '/about', label: 'About Us' },
    { href: '/case-studies', label: 'Case Studies' },
    { href: '/contact', label: 'Contact' },
    { href: '/get-a-quote', label: 'Get a Quote' },
    { href: 'https://blog.niksconsulting.com', label: 'Blog', external: true },
  ],
};
---

<footer class="bg-dark-900 border-t border-dark-700/50">
  <div class="container-custom section-padding !py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-9 h-9 rounded-lg bg-accent-gradient flex items-center justify-center font-display font-bold text-white text-lg">
            N
          </div>
          <span class="font-display font-bold text-lg text-white">
            Niks<span class="text-primary-400">Consulting</span>
          </span>
        </a>
        <p class="text-dark-400 text-sm leading-relaxed mb-6">
          Pioneers in AI Solutions & Innovation. We deliver AI-powered solutions, agentic workflows, and digital transformation for startups and SMEs.
        </p>
        <div class="flex gap-3">
          <a href="https://www.linkedin.com/in/ntiwari1" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-dark-800 border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500/50 hover:bg-dark-700 transition-all" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-lg bg-dark-800 border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500/50 hover:bg-dark-700 transition-all" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-lg bg-dark-800 border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500/50 hover:bg-dark-700 transition-all" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://x.com/niksconsulting" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-dark-800 border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500/50 hover:bg-dark-700 transition-all" aria-label="X (Twitter)">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services Links -->
      <div>
        <h4 class="font-display font-semibold text-white mb-4">Services</h4>
        <ul class="space-y-3">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-dark-400 hover:text-primary-300 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="font-display font-semibold text-white mb-4">Company</h4>
        <ul class="space-y-3">
          {footerLinks.company.map((link) => (
            <li>
              <a
                href={link.external ? 'https://blog.niksconsulting.com' : link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-sm text-dark-400 hover:text-primary-300 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="font-display font-semibold text-white mb-4">Get in Touch</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:info@niksconsulting.com" class="text-sm text-dark-400 hover:text-primary-300 transition-colors">
              info@niksconsulting.com
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <!-- REPLACE: Your actual phone -->
            <a href="tel:+1234567890" class="text-sm text-dark-400 hover:text-primary-300 transition-colors">
              +1 (234) 567-890
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <!-- REPLACE: Your actual address -->
            <span class="text-sm text-dark-400">
              Your City, Country
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-dark-700/50 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-dark-500">
        &copy; {currentYear} Niks Consulting. All rights reserved.
      </p>
      <p class="text-sm text-dark-500">
        Built with passion by <a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">Niks Consulting</a>
      </p>
    </div>
  </div>
</footer>
