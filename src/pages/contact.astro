---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us — Niks Consulting" description="Get in touch with Niks Consulting. Book a free consultation, send us a message, or chat on WhatsApp.">
  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.1),transparent_60%)]"></div>
    <div class="relative container-custom section-padding !py-0 text-center">
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-white mb-6">
        Get in <span class="gradient-text">Touch</span>
      </h1>
      <p class="text-lg text-dark-300 max-w-2xl mx-auto">
        Ready to start your AI-powered digital transformation? We'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding bg-dark-900">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Left: Contact Info & Scheduling -->
        <div class="space-y-8">
          <!-- Contact Methods -->
          <div>
            <h2 class="font-display font-bold text-2xl text-white mb-6">Contact Information</h2>
            <div class="space-y-4">
              <!-- Email -->
              <a href="mailto:info@niksconsulting.com" class="glass-card p-4 flex items-center gap-4 group hover:border-primary-500/30 transition-all">
                <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-dark-400">Email</p>
                  <p class="text-white group-hover:text-primary-300 transition-colors">info@niksconsulting.com</p>
                </div>
              </a>

              <!-- Phone -->
              <a href="tel:+1234567890" class="glass-card p-4 flex items-center gap-4 group hover:border-primary-500/30 transition-all">
                <div class="w-12 h-12 rounded-xl bg-accent-500/20 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-dark-400">Phone</p>
                  <!-- REPLACE: Your actual phone -->
                  <p class="text-white group-hover:text-primary-300 transition-colors">+1 (234) 567-890</p>
                </div>
              </a>

              <!-- WhatsApp -->
              <a
                href="https://wa.me/1234567890?text=Hi%2C%20I%27m%20interested%20in%20your%20consulting%20services."
                target="_blank"
                rel="noopener noreferrer"
                class="glass-card p-4 flex items-center gap-4 group hover:border-green-500/30 transition-all"
              >
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-dark-400">WhatsApp</p>
                  <!-- REPLACE: Your actual WhatsApp number -->
                  <p class="text-white group-hover:text-green-300 transition-colors">Chat with us instantly</p>
                </div>
              </a>
            </div>
          </div>

          <!-- OnceHub Scheduling -->
          <div>
            <h2 class="font-display font-bold text-2xl text-white mb-4">Book a Consultation</h2>
            <p class="text-dark-400 mb-6">Schedule a free 30-minute consultation at a time that works for you.</p>
            <div class="glass-card p-6 min-h-[400px] flex items-center justify-center">
              <!--
                REPLACE: OnceHub Scheduling Widget
                Replace the placeholder below with your actual OnceHub embed code.
                You can find this in your OnceHub dashboard under Share & Publish > Embed.
              -->
              <div class="text-center">
                <div class="w-16 h-16 rounded-2xl bg-primary-500/20 flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
                <p class="text-white font-semibold mb-2">Schedule Your Free Consultation</p>
                <p class="text-sm text-dark-400 mb-4">Click below to open our scheduling page</p>
                <!-- REPLACE: Your actual OnceHub scheduling link -->
                <a
                  href="https://go.oncehub.com/nik4u"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary text-sm"
                >
                  Open Scheduling Page
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>
              <!-- OnceHub embed example:
              <div class="inline-embed-widget" data-url="https://go.oncehub.com/niksconsulting" style="width:100%;height:600px;"></div>
              <script src="https://cdn.oncehub.com/mergedjs/od.js" defer></script>
              -->
            </div>
          </div>
        </div>

        <!-- Right: Freshsales Contact Form -->
        <div>
          <h2 class="font-display font-bold text-2xl text-white mb-6">Send Us a Message</h2>
          <div class="glass-card p-8">
            <!--
              REPLACE: Freshsales Web Form Embed
              Replace the form below with your actual Freshsales web form embed code.
              You can create a web form in Freshsales under Admin Settings > Web Forms.
            -->
            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="first_name" class="block text-sm font-medium text-dark-200 mb-2">First Name *</label>
                  <input type="text" id="first_name" name="first_name" required class="input-field" placeholder="John" />
                </div>
                <div>
                  <label for="last_name" class="block text-sm font-medium text-dark-200 mb-2">Last Name *</label>
                  <input type="text" id="last_name" name="last_name" required class="input-field" placeholder="Doe" />
                </div>
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-dark-200 mb-2">Email *</label>
                <input type="email" id="email" name="email" required class="input-field" placeholder="john@example.com" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-dark-200 mb-2">Phone</label>
                <input type="tel" id="phone" name="phone" class="input-field" placeholder="+1 (234) 567-890" />
              </div>
              <div>
                <label for="service" class="block text-sm font-medium text-dark-200 mb-2">Service Interested In</label>
                <select id="service" name="service" class="input-field">
                  <option value="">Select a service...</option>
                  <option value="ai-solutions">AI Solutions & Agentic AI</option>
                  <option value="ai-automation">AI Automation</option>
                  <option value="digital-transformation">Digital Transformation</option>
                  <option value="website-development">Website & App Development</option>
                  <option value="ai-social-media">AI-Powered Social Media</option>
                  <option value="agile-management">Agile Project Management</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-dark-200 mb-2">Message *</label>
                <textarea id="message" name="message" rows="4" required class="input-field resize-none" placeholder="Tell us about your project..."></textarea>
              </div>
              <button type="submit" class="btn-primary w-full">
                Send Message
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
              </button>
            </form>
            <!--
              To replace with Freshsales embed:
              1. Go to Freshsales > Admin Settings > Web Forms
              2. Create/configure your form
              3. Copy the embed code
              4. Replace the <form> above with the Freshsales embed code
            -->
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // REPLACE: Add your Freshsales form submission logic or redirect
    alert('Thank you for your message! We will get back to you within 24 hours.');
  });
</script>
