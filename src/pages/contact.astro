---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us | Get a Free AI Consulting Quote" description="Get in touch with Nik's Consulting. Book a free consultation, send a message, or chat on WhatsApp. Response within 24 hours.">
  <!-- Hero -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(6,182,212,0.1),transparent_50%)]"></div>
    <!-- Decorative orbs -->
    <div class="absolute top-16 left-[15%] w-72 h-72 rounded-full bg-brand-500/8 blur-[100px] animate-glow-pulse"></div>
    <div class="absolute bottom-10 right-[10%] w-64 h-64 rounded-full bg-violet-500/8 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <!-- Decorative shapes -->
    <svg class="absolute top-20 right-[18%] w-14 h-14 text-brand-500/10 animate-float" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="32" cy="32" r="24"/></svg>
    <svg class="absolute bottom-24 left-[22%] w-10 h-10 text-violet-500/10 animate-float" style="animation-delay: 3s;" viewBox="0 0 64 64" fill="currentColor"><rect x="16" y="16" width="32" height="32" rx="6" transform="rotate(12 32 32)"/></svg>
    <!-- Hero illustration background -->
    <img src="/images/hero-contact.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />

    <div class="relative container-custom section-padding !py-0 text-center">
      <span class="badge-brand mb-6 inline-flex">Let's Connect</span>
      <h1 class="heading-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-ink-100 mb-8">
        Get in <span class="gradient-text">Touch</span>
      </h1>
      <p class="text-xl text-ink-300 max-w-3xl mx-auto leading-relaxed">
        Ready to start your <span class="text-ink-100 font-medium">AI-powered digital transformation</span>? We'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0L1440 80L1440 100L0 100Z" fill="var(--color-surface-0)"/>
    </svg>
  </div>

  <!-- Contact Section -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(6,182,212,0.04),transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(139,92,246,0.04),transparent_50%)]"></div>
    <div class="container-custom relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">
        <!-- Left: Contact Info & Scheduling -->
        <div class="space-y-10">
          <!-- Contact Methods -->
          <div>
            <span class="badge-brand mb-5 inline-flex">Reach Out</span>
            <h2 class="font-display font-extrabold text-3xl text-ink-100 mb-8">Contact Information</h2>
            <div class="space-y-5">
              <!-- Email -->
              <a href="mailto:info@niksconsulting.com" class="relative rounded-2xl border border-brand-500/20 p-5 flex items-center gap-5 group hover:border-brand-500/40 transition-all duration-300 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-brand-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative w-14 h-14 rounded-2xl bg-brand-500/15 flex items-center justify-center shrink-0">
                  <svg class="w-7 h-7 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div class="relative">
                  <p class="text-sm text-ink-400 font-medium">Email</p>
                  <p class="text-ink-100 group-hover:text-brand-300 transition-colors font-semibold text-lg">info@niksconsulting.com</p>
                </div>
              </a>

              <!-- Phone -->
              <a href="tel:+1234567890" class="relative rounded-2xl border border-violet-500/20 p-5 flex items-center gap-5 group hover:border-violet-500/40 transition-all duration-300 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-violet-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative w-14 h-14 rounded-2xl bg-violet-500/15 flex items-center justify-center shrink-0">
                  <svg class="w-7 h-7 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div class="relative">
                  <p class="text-sm text-ink-400 font-medium">Phone</p>
                  <!-- REPLACE: Your actual phone -->
                  <p class="text-ink-100 group-hover:text-violet-300 transition-colors font-semibold text-lg">+1 (234) 567-890</p>
                </div>
              </a>

              <!-- WhatsApp -->
              <a
                href="https://wa.me/1234567890?text=Hi%2C%20I%27m%20interested%20in%20your%20consulting%20services."
                target="_blank"
                rel="noopener noreferrer"
                class="relative rounded-2xl border border-emerald-500/20 p-5 flex items-center gap-5 group hover:border-emerald-500/40 transition-all duration-300 overflow-hidden"
              >
                <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative w-14 h-14 rounded-2xl bg-emerald-500/15 flex items-center justify-center shrink-0">
                  <svg class="w-7 h-7 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div class="relative">
                  <p class="text-sm text-ink-400 font-medium">WhatsApp</p>
                  <!-- REPLACE: Your actual WhatsApp number -->
                  <p class="text-ink-100 group-hover:text-emerald-300 transition-colors font-semibold text-lg">Chat with us instantly</p>
                </div>
              </a>
            </div>
          </div>

          <!-- OnceHub Scheduling -->
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-sm font-medium mb-5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              Schedule
            </span>
            <h2 class="font-display font-extrabold text-3xl text-ink-100 mb-4">Book a Consultation</h2>
            <p class="text-ink-400 mb-7 text-lg">Schedule a free 30-minute consultation at a time that works for you.</p>
            <div class="relative rounded-2xl border border-amber-500/20 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent"></div>
              <div class="relative p-8 min-h-[250px] sm:min-h-[400px] flex items-center justify-center">
                <!--
                  REPLACE: OnceHub Scheduling Widget
                  Replace the placeholder below with your actual OnceHub embed code.
                  You can find this in your OnceHub dashboard under Share & Publish > Embed.
                -->
                <div class="text-center">
                  <div class="w-20 h-20 rounded-3xl bg-amber-500/15 flex items-center justify-center mx-auto mb-6 shadow-lg shadow-amber-500/10">
                    <svg class="w-10 h-10 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <p class="text-ink-100 font-bold text-xl mb-2">Schedule Your Free Consultation</p>
                  <p class="text-sm text-ink-400 mb-6">Click below to open our scheduling page</p>
                  <!-- REPLACE: Your actual OnceHub scheduling link -->
                  <a
                    href="https://go.oncehub.com/nik4u"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary text-sm"
                  >
                    Open Scheduling Page
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                </div>
                <!-- OnceHub embed example:
                <div class="inline-embed-widget" data-url="https://go.oncehub.com/niksconsulting" style="width:100%;height:600px;"></div>
                <script src="https://cdn.oncehub.com/mergedjs/od.js" defer></script>
                -->
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Freshsales Contact Form -->
        <div>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-sm font-medium mb-5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            Message Us
          </span>
          <h2 class="font-display font-extrabold text-3xl text-ink-100 mb-8">Send Us a Message</h2>

          <div class="relative rounded-2xl border border-violet-500/20 overflow-hidden">
            <!-- Gradient mesh background -->
            <div class="absolute inset-0 bg-gradient-to-br from-violet-500/5 via-transparent to-brand-500/5"></div>
            <div class="absolute -top-32 -right-32 w-64 h-64 rounded-full bg-violet-500/8 blur-[80px]"></div>
            <div class="absolute -bottom-32 -left-32 w-64 h-64 rounded-full bg-brand-500/6 blur-[80px]"></div>

            <div class="relative p-8 lg:p-10">
              <!--
                REPLACE: Freshsales Web Form Embed
                Replace the form below with your actual Freshsales web form embed code.
                You can create a web form in Freshsales under Admin Settings > Web Forms.
              -->
              <div id="contact-success" class="hidden text-center py-12">
                <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h3 class="font-display font-bold text-2xl text-ink-100 mb-2">Thank You!</h3>
                <p class="text-ink-300">We've received your message and will respond within 24 hours.</p>
              </div>
              <form id="contact-form" class="space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="first_name" class="block text-sm font-semibold text-ink-200 mb-2.5">First Name *</label>
                    <input type="text" id="first_name" name="first_name" required class="input-field" placeholder="John" />
                  </div>
                  <div>
                    <label for="last_name" class="block text-sm font-semibold text-ink-200 mb-2.5">Last Name *</label>
                    <input type="text" id="last_name" name="last_name" required class="input-field" placeholder="Doe" />
                  </div>
                </div>
                <div>
                  <label for="email" class="block text-sm font-semibold text-ink-200 mb-2.5">Email *</label>
                  <input type="email" id="email" name="email" required class="input-field" placeholder="john@example.com" />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-semibold text-ink-200 mb-2.5">Phone</label>
                  <input type="tel" id="phone" name="phone" class="input-field" placeholder="+1 (234) 567-890" />
                </div>
                <div>
                  <label for="service" class="block text-sm font-semibold text-ink-200 mb-2.5">Service Interested In</label>
                  <select id="service" name="service" class="input-field">
                    <option value="">Select a service...</option>
                    <option value="ai-solutions">AI Solutions & Agentic AI</option>
                    <option value="ai-automation">AI Automation</option>
                    <option value="digital-transformation">Digital Transformation</option>
                    <option value="website-development">Website & App Development</option>
                    <option value="ai-social-media">AI-Powered Social Media</option>
                    <option value="agile-management">Agile Project Management</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div>
                  <label for="message" class="block text-sm font-semibold text-ink-200 mb-2.5">Message *</label>
                  <textarea id="message" name="message" rows="5" required class="input-field resize-none" placeholder="Tell us about your project..."></textarea>
                </div>
                <button type="submit" class="btn-primary w-full text-base py-4">
                  Send Message
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                </button>
              </form>
              <!--
                To replace with Freshsales embed:
                1. Go to Freshsales > Admin Settings > Web Forms
                2. Create/configure your form
                3. Copy the embed code
                4. Replace the <form> above with the Freshsales embed code
              -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // REPLACE: Add your Freshsales form submission logic or redirect
    form?.classList.add('hidden');
    document.getElementById('contact-success')?.classList.remove('hidden');
  });
</script>
