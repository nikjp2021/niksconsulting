---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const trainingFormats = [
  {
    icon: 'users',
    title: 'AI Workshops',
    subtitle: 'Half-day or full-day sessions for teams of 10-30',
    description: 'Interactive, hands-on workshops where your team learns to use AI tools relevant to their roles. We cover prompt engineering, AI workflow automation, and practical implementation. Each participant leaves with actionable skills they can apply the next day.',
    features: [
      'Customized to your industry and tools',
      'Hands-on exercises with real data',
      'Take-home playbook and resources',
      'Follow-up Q&A session (1 week later)',
      'Group size: 10-30 participants',
      'Duration: Half-day (4h) or Full-day (8h)',
    ],
    price: 'Starting from ¥150,000',
    accent: {
      bg: 'bg-emerald-500/10',
      border: 'border-emerald-500/20',
      text: 'text-emerald-400',
      ring: 'bg-emerald-500/20',
      gradient: 'from-emerald-500 to-teal-600',
      orb: 'rgba(16,185,129,0.12)',
      badge: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/20',
    },
  },
  {
    icon: 'group',
    title: 'Small Group Cohorts',
    subtitle: '4-week intensive for teams of 3-8',
    description: 'A structured 4-week program where small teams deep-dive into AI implementation. Weekly sessions cover theory, practical exercises, and real project work. Perfect for teams building AI-powered products or automating workflows.',
    features: [
      '4 weekly sessions (2 hours each)',
      'Real project work between sessions',
      'Personalized feedback and guidance',
      'Slack channel for ongoing support',
      'Certificate of completion',
      'Group size: 3-8 participants',
    ],
    price: 'Starting from ¥280,000 per group',
    accent: {
      bg: 'bg-cyan-500/10',
      border: 'border-cyan-500/20',
      text: 'text-cyan-400',
      ring: 'bg-cyan-500/20',
      gradient: 'from-cyan-500 to-blue-600',
      orb: 'rgba(6,182,212,0.12)',
      badge: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/20',
    },
  },
  {
    icon: 'user',
    title: '1:1 AI Coaching',
    subtitle: 'Personalized training for founders and leaders',
    description: 'One-on-one sessions tailored to your specific goals. Whether you\'re a founder looking to integrate AI into your product, a product manager wanting to leverage AI for better decisions, or an executive exploring AI strategy — we build a custom curriculum for you.',
    features: [
      'Personalized curriculum design',
      'Flexible scheduling (weekly or bi-weekly)',
      'Real-time project collaboration',
      'Access to exclusive AI tool recommendations',
      'Ongoing support between sessions',
      'Duration: 60-90 min per session',
    ],
    price: 'Starting from ¥50,000 per session',
    accent: {
      bg: 'bg-amber-500/10',
      border: 'border-amber-500/20',
      text: 'text-amber-400',
      ring: 'bg-amber-500/20',
      gradient: 'from-amber-500 to-orange-600',
      orb: 'rgba(245,158,11,0.12)',
      badge: 'bg-amber-500/15 text-amber-300 border-amber-500/20',
    },
  },
];

const audiences = [
  { icon: 'rocket', title: 'Startup Founders', desc: 'Building AI products from the ground up', color: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' },
  { icon: 'kanban', title: 'Product Managers', desc: 'Leveraging AI for smarter product decisions', color: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20' },
  { icon: 'code', title: 'Development Teams', desc: 'Implementing AI features and integrations', color: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' },
  { icon: 'share-2', title: 'Marketing Teams', desc: 'Using AI for content creation and automation', color: 'text-amber-400 bg-amber-500/10 border-amber-500/20' },
  { icon: 'trending-up', title: 'Executives', desc: 'Exploring AI strategy and digital transformation', color: 'text-pink-400 bg-pink-500/10 border-pink-500/20' },
];
---

<BaseLayout title="AI Training Workshops & Coaching | Nik's Consulting" description="Hands-on AI training: workshops for teams of 10-30, small group cohorts, and 1:1 coaching. Practical skills your team can apply the next day.">

  <!-- Structured Data: Course -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "AI Training & Onboarding",
    "description": "Hands-on AI training workshops, small group programs, and 1:1 coaching",
    "provider": { "@type": "ProfessionalService", "name": "Nik's Consulting" },
    "offers": [
      { "@type": "Offer", "name": "AI Workshop", "price": "150000", "priceCurrency": "JPY" },
      { "@type": "Offer", "name": "Small Group Cohort", "price": "280000", "priceCurrency": "JPY" },
      { "@type": "Offer", "name": "1:1 Coaching", "price": "50000", "priceCurrency": "JPY" }
    ]
  })} />
  <!-- Hero -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.1),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(6,182,212,0.1),transparent_50%)]"></div>
    <!-- Decorative orbs -->
    <div class="absolute top-20 left-[10%] w-72 h-72 rounded-full bg-accent-amber/8 blur-[100px] animate-glow-pulse"></div>
    <div class="absolute bottom-10 right-[15%] w-64 h-64 rounded-full bg-cyan-500/8 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <!-- Decorative SVG shapes -->
    <svg class="absolute top-16 right-[20%] w-16 h-16 text-accent-amber/10 animate-float" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 24v-4a8 8 0 0116 0v4"/><rect x="12" y="24" width="40" height="24" rx="4"/><circle cx="32" cy="36" r="4"/></svg>
    <svg class="absolute bottom-24 left-[25%] w-12 h-12 text-cyan-500/10 animate-float" style="animation-delay: 3s;" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><rect x="12" y="12" width="40" height="40" rx="8" transform="rotate(15 32 32)"/></svg>
    <!-- Hero illustration background -->
    <img src="/images/hero-services.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />
    <div class="relative container-custom section-padding !py-0 text-center">
      <span class="badge-brand mb-6 inline-flex">AI Training &amp; Onboarding</span>
      <h1 class="heading-display text-5xl sm:text-6xl lg:text-7xl text-ink-100 mb-8">
        Master AI with <span class="gradient-text">Hands-On Training</span>
      </h1>
      <p class="text-xl text-ink-300 max-w-3xl mx-auto leading-relaxed">
        From workshops to 1:1 coaching &mdash; practical AI training for teams and individuals who want to <span class="text-ink-100 font-medium">ship, not just learn</span>.
      </p>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0L1440 80L1440 100L0 100Z" fill="#09090b"/>
    </svg>
  </div>

  <!-- Training Formats Section -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(6,182,212,0.04),transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(139,92,246,0.04),transparent_50%)]"></div>
    <div class="container-custom relative">
      <SectionHeading
        tag="Training Formats"
        title="Choose Your Learning Path"
        subtitle="Three distinct training formats designed to fit your team's size, goals, and schedule."
        light
      />

      <div class="space-y-20">
        {trainingFormats.map((format, index) => (
          <div
            class:list={[
              'relative scroll-mt-24',
            ]}
            data-reveal="fade-up"
            data-delay={String(index * 100)}
          >
            <!-- Decorative background orb -->
            <div class:list={[
              'absolute -top-20 w-[500px] h-[500px] rounded-full blur-[140px] opacity-30 pointer-events-none',
              index % 2 === 0 ? '-right-40' : '-left-40',
            ]} style={`background: ${format.accent.orb};`}></div>

            <div class:list={[
              'grid grid-cols-1 lg:grid-cols-2 gap-16 items-center',
            ]}>
              {/* Content */}
              <div class:list={[index % 2 === 1 && 'lg:order-2']}>
                <!-- Badge & number -->
                <div class="flex items-center gap-4 mb-6">
                  <span class:list={['inline-flex items-center justify-center w-10 h-10 rounded-xl text-sm font-bold border', format.accent.bg, format.accent.border, format.accent.text]}>
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class:list={['inline-flex items-center px-3 py-1 text-xs font-medium rounded-full border', format.accent.badge]}>
                    {format.title.split(' ')[0]}
                  </span>
                </div>

                <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 mb-3 leading-tight">
                  {format.title}
                </h2>
                <p class:list={['text-lg font-medium mb-5', format.accent.text]}>
                  {format.subtitle}
                </p>
                <p class="text-ink-300 text-lg leading-relaxed mb-8">
                  {format.description}
                </p>

                <!-- Features list -->
                <div class:list={['rounded-2xl border p-6 mb-6', format.accent.bg, format.accent.border]}>
                  <h4 class:list={['text-sm font-semibold uppercase tracking-wider mb-4', format.accent.text]}>What's Included</h4>
                  <ul class="space-y-3">
                    {format.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <svg class:list={['w-5 h-5 mt-0.5 shrink-0', format.accent.text]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-ink-200 text-sm">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Price indicator -->
                <div class:list={['inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border text-sm font-bold', format.accent.bg, format.accent.border, format.accent.text]}>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {format.price}
                </div>
              </div>

              {/* Visual Card */}
              <div class:list={[index % 2 === 1 && 'lg:order-1']}>
                <div class:list={['relative rounded-3xl overflow-hidden border', format.accent.border]}>
                  <!-- Gradient mesh background -->
                  <div class:list={['absolute inset-0 bg-gradient-to-br opacity-10', format.accent.gradient]}></div>
                  <div class:list={['absolute top-0 right-0 w-48 h-48 rounded-full blur-[80px] opacity-20', format.accent.bg]} style={`background: ${format.accent.orb};`}></div>

                  <div class="relative p-10 lg:p-14">
                    <!-- Large icon -->
                    <div class:list={['w-24 h-24 rounded-3xl bg-gradient-to-br flex items-center justify-center mb-10 shadow-lg', format.accent.gradient]}>
                      {format.icon === 'users' && (
                        <svg class="w-12 h-12 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                      )}
                      {format.icon === 'group' && (
                        <svg class="w-12 h-12 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                      )}
                      {format.icon === 'user' && (
                        <svg class="w-12 h-12 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                      )}
                    </div>

                    <h3 class="font-display font-bold text-2xl text-ink-100 mb-8">
                      Why Choose {format.title}?
                    </h3>
                    <div class="space-y-5">
                      {format.features.slice(0, 4).map((f, i) => (
                        <div class="flex items-center gap-4">
                          <div class:list={['w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold shrink-0', format.accent.ring, format.accent.text]}>
                            {String(i + 1).padStart(2, '0')}
                          </div>
                          <span class="text-ink-200">{f}</span>
                        </div>
                      ))}
                    </div>

                    <!-- Decorative dots pattern -->
                    <div class="absolute bottom-6 right-6 grid grid-cols-3 gap-2 opacity-20">
                      {[...Array(9)].map(() => (
                        <div class:list={['w-1.5 h-1.5 rounded-full', format.accent.bg.replace('/10', '/40')]}></div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Section divider -->
            {index < trainingFormats.length - 1 && (
              <div class="flex justify-center mt-20">
                <div class:list={['w-24 h-0.5 rounded-full bg-gradient-to-r', format.accent.gradient, 'opacity-30']}></div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AI Onboarding Section -->
  <section class="relative overflow-hidden">
    <svg class="w-full h-20 lg:h-28 -mb-1" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 100L1440 20L1440 0L0 0Z" fill="#09090b"/>
    </svg>
    <div class="bg-surface-1 pb-24 lg:pb-32 pt-4 relative">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.06),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(6,182,212,0.06),transparent_50%)]"></div>
      <!-- Floating orbs -->
      <div class="absolute top-0 left-[20%] w-60 h-60 rounded-full bg-accent-amber/6 blur-[100px] animate-glow-pulse"></div>
      <div class="absolute bottom-0 right-[20%] w-60 h-60 rounded-full bg-cyan-500/6 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>

      <div class="container-custom relative section-padding !py-0">
        <SectionHeading
          tag="Team Onboarding"
          title="AI-Powered Team Onboarding"
          subtitle="We help your new hires become productive faster by training them on your AI tools and workflows from day one. Custom onboarding programs that reduce ramp-up time by 60%."
          light
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-reveal="fade-up">
          {[
            { icon: 'brain', title: 'AI Tool Orientation', desc: 'Hands-on walkthrough of your team\'s AI stack', color: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' },
            { icon: 'kanban', title: 'Workflow Documentation', desc: 'Clear guides for AI-enhanced processes', color: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20' },
            { icon: 'zap', title: 'Hands-on Practice', desc: 'Real exercises with your actual tools and data', color: 'text-amber-400 bg-amber-500/10 border-amber-500/20' },
            { icon: 'headphones', title: '30-Day Support', desc: 'Ongoing help as new hires ramp up', color: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' },
          ].map((item) => (
            <div class:list={['relative rounded-2xl border p-8 overflow-hidden group', item.color.split(' ').filter(c => c.startsWith('border-')).join(' ') ]}>
              <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/[0.03] via-transparent to-cyan-500/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="relative">
                <div class:list={['w-14 h-14 rounded-2xl flex items-center justify-center mb-5', item.color.split(' ').filter(c => c.startsWith('bg-')).join(' ')]}>
                  {item.icon === 'brain' && (
                    <svg class:list={['w-7 h-7', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                  )}
                  {item.icon === 'kanban' && (
                    <svg class:list={['w-7 h-7', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                    </svg>
                  )}
                  {item.icon === 'zap' && (
                    <svg class:list={['w-7 h-7', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                  )}
                  {item.icon === 'headphones' && (
                    <svg class:list={['w-7 h-7', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                    </svg>
                  )}
                </div>
                <h3 class="font-display font-bold text-lg text-ink-100 mb-2">{item.title}</h3>
                <p class="text-sm text-ink-400 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Who It's For Section -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(6,182,212,0.04),transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(245,158,11,0.04),transparent_50%)]"></div>
    <div class="container-custom relative">
      <SectionHeading
        tag="Target Audience"
        title="Who It's For"
        subtitle="Whether you're a solo founder or an enterprise team, we tailor our AI training to your context."
        light
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5" data-reveal="fade-up">
        {audiences.map((item) => (
          <div class:list={['relative rounded-2xl border p-6 text-center overflow-hidden group transition-all duration-300 hover:-translate-y-1', item.color.split(' ').filter(c => c.startsWith('border-')).join(' ')]}>
            <div class="absolute inset-0 bg-gradient-to-br from-brand-500/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative">
              <div class:list={['w-12 h-12 rounded-xl flex items-center justify-center mx-auto mb-4', item.color.split(' ').filter(c => c.startsWith('bg-')).join(' ')]}>
                {item.icon === 'rocket' && (
                  <svg class:list={['w-6 h-6', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>
                  </svg>
                )}
                {item.icon === 'kanban' && (
                  <svg class:list={['w-6 h-6', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                  </svg>
                )}
                {item.icon === 'code' && (
                  <svg class:list={['w-6 h-6', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                )}
                {item.icon === 'share-2' && (
                  <svg class:list={['w-6 h-6', item.color.split(' ').filter(c => c.startsWith('text-')).join(' ')]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
