---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Gifted Internship Program | Real-World AI Projects" description="Join the Gifted Internship Program: 5 years of real-world AI projects, graduates from 8 countries, 100% employment rate. Apply now for the next cohort.">

  <!-- Structured Data: EducationalOccupationalProgram -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "EducationalOccupationalProgram",
    "name": "Gifted Internship Program",
    "description": "Real-world project-based internship running since 2020 from Japan",
    "provider": { "@type": "ProfessionalService", "name": "Nik's Consulting" },
    "educationalProgramMode": "full-time",
    "timeToComplete": "P3M",
    "occupationalCategory": "AI, Digital Transformation, Web Development"
  })} />
  <!-- Hero -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(245,158,11,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(16,185,129,0.1),transparent_50%)]"></div>
    <!-- Decorative orbs -->
    <div class="absolute top-20 right-[10%] w-80 h-80 rounded-full bg-amber-500/8 blur-[120px] animate-glow-pulse"></div>
    <div class="absolute bottom-10 left-[15%] w-64 h-64 rounded-full bg-emerald-500/8 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <!-- Decorative shapes -->
    <svg class="absolute top-24 left-[15%] w-14 h-14 text-amber-500/10 animate-float" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
      <polygon points="32,4 60,52 4,52"/>
    </svg>
    <svg class="absolute bottom-20 right-[20%] w-10 h-10 text-emerald-500/10 animate-float" style="animation-delay: 2s;" viewBox="0 0 64 64" fill="currentColor">
      <circle cx="32" cy="32" r="10"/>
    </svg>
    <!-- Hero illustration background -->
    <img src="/images/hero-gifted.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />

    <div class="relative container-custom section-padding !py-0 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        Since 2020 &bull; Japan
      </span>
      <h1 class="heading-display text-5xl sm:text-6xl lg:text-7xl text-ink-100 mb-8">
        The <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-400 via-orange-400 to-emerald-400">Gifted</span> Internship Program
      </h1>
      <p class="text-xl text-ink-300 max-w-3xl mx-auto leading-relaxed">
        5 years of transforming students into <span class="text-ink-100 font-medium">industry leaders</span> through real-world projects and problem-solving.
      </p>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0L1440 80L1440 100L0 100Z" fill="#09090b"/>
    </svg>
  </div>

  <!-- Program Overview -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-amber-500/4 blur-[160px] pointer-events-none"></div>
    <div class="container-custom relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div data-reveal="fade-right">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm font-medium mb-6">
            What is Gifted?
          </span>
          <h2 class="heading-display text-4xl sm:text-5xl text-ink-100 mb-8 leading-tight">
            Hands-On Internships That <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-400 to-emerald-400">Build Careers</span>
          </h2>
          <div class="space-y-5 text-ink-300 text-lg leading-relaxed">
            <p>
              The Gifted Internship Program is a hands-on, project-based internship that connects university students with <strong class="text-ink-100">real business challenges</strong>. Running since 2020 from Shizuoka, Japan, the program has successfully trained students from 8 countries.
            </p>
            <p>
              Participants work on <strong class="text-ink-100">actual client projects</strong>, receive mentorship from industry professionals, and graduate with a portfolio that demonstrates real-world impact — not simulations.
            </p>
            <p>
              Countries represented: <strong class="text-amber-400">Vietnam</strong>, <strong class="text-emerald-400">Brazil</strong>, <strong class="text-brand-400">USA</strong>, <strong class="text-violet-400">Nigeria</strong>, <strong class="text-cyan-400">Indonesia</strong>, <strong class="text-pink-400">India</strong>, <strong class="text-orange-400">Philippines</strong>, and <strong class="text-amber-300">Japan</strong>.
            </p>
          </div>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-5" data-reveal="fade-left">
          {[
            { number: '5', label: 'Years Running', suffix: '+', color: 'from-amber-500/15 to-orange-500/15', border: 'border-amber-500/20', accent: 'text-amber-400' },
            { number: '8', label: 'Countries Represented', suffix: '', color: 'from-emerald-500/15 to-teal-500/15', border: 'border-emerald-500/20', accent: 'text-emerald-400' },
            { number: '20', label: 'Graduates', suffix: '+', color: 'from-brand-500/15 to-cyan-500/15', border: 'border-brand-500/20', accent: 'text-brand-400' },
            { number: '100', label: 'Employment Rate', suffix: '%', color: 'from-violet-500/15 to-purple-500/15', border: 'border-violet-500/20', accent: 'text-violet-400' },
          ].map((stat) => (
            <div class:list={['relative rounded-2xl border p-7 text-center overflow-hidden', stat.border]}>
              <div class:list={['absolute inset-0 bg-gradient-to-br', stat.color]}></div>
              <div class="relative">
                <div class:list={['font-display font-extrabold text-4xl mb-2', stat.accent]}>
                  {stat.number}<span class="text-2xl">{stat.suffix}</span>
                </div>
                <p class="text-sm text-ink-400 font-medium">{stat.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Curved divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0C360 80 1080 80 1440 0L1440 100L0 100Z" fill="#0f0f13"/>
    </svg>
  </div>

  <!-- How It Works -->
  <section class="pb-20 lg:pb-28 bg-surface-1 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.06),transparent_60%)]"></div>
    <div class="container-custom relative">
      <SectionHeading
        title="How It Works"
        subtitle="Four steps from application to graduation. No simulations — just real work."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          { step: '01', title: 'Apply', desc: 'Submit your application with your background, skills, and goals.', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', color: 'from-amber-500/15 to-orange-500/10', border: 'border-amber-500/20', iconColor: 'text-amber-400', ring: 'bg-amber-500/15' },
          { step: '02', title: 'Match', desc: 'We match you with a real-world project based on your skills and interests.', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', color: 'from-emerald-500/15 to-teal-500/10', border: 'border-emerald-500/20', iconColor: 'text-emerald-400', ring: 'bg-emerald-500/15' },
          { step: '03', title: 'Build', desc: 'Work on actual client projects with mentorship and guidance from professionals.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z', color: 'from-brand-500/15 to-cyan-500/10', border: 'border-brand-500/20', iconColor: 'text-brand-400', ring: 'bg-brand-500/15' },
          { step: '04', title: 'Graduate', desc: 'Complete the program with a portfolio, skills, and industry connections.', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z', color: 'from-violet-500/15 to-purple-500/10', border: 'border-violet-500/20', iconColor: 'text-violet-400', ring: 'bg-violet-500/15' },
        ].map((item, i) => (
          <div class:list={['relative rounded-2xl border overflow-hidden group hover:-translate-y-1 transition-all duration-300', item.border]} data-reveal="fade-up" data-delay={String(i * 100)}>
            <div class:list={['absolute inset-0 bg-gradient-to-br', item.color]}></div>
            <div class="relative p-8 text-center">
              <div class="font-display font-extrabold text-5xl text-ink-500/30 mb-4">{item.step}</div>
              <div class:list={['w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-6', item.ring]}>
                <svg class:list={['w-7 h-7', item.iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
                </svg>
              </div>
              <h3 class="font-display font-bold text-xl text-ink-100 mb-3">{item.title}</h3>
              <p class="text-sm text-ink-400 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 80L1440 0L1440 100L0 100Z" fill="#09090b"/>
    </svg>
  </div>

  <!-- Success Stories -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(245,158,11,0.06),transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(16,185,129,0.06),transparent_50%)]"></div>
    <div class="container-custom relative">
      <SectionHeading
        title="Success Stories"
        subtitle="From interns to leaders. These are the people who started with Gifted and built extraordinary careers."
      />

      <div class="space-y-12">
        <!-- Ebele -->
        <div class="relative rounded-3xl border border-amber-500/20 overflow-hidden group hover:border-amber-500/40 transition-all duration-300" data-reveal="fade-up">
          <!-- Gradient mesh background -->
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/8 via-transparent to-emerald-500/5"></div>
          <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-amber-500/8 blur-[120px]"></div>
          <div class="absolute bottom-0 left-0 w-60 h-60 rounded-full bg-emerald-500/6 blur-[100px]"></div>

          <div class="relative p-8 lg:p-12">
            <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
              <!-- Photo -->
              <div class="relative shrink-0">
                <!--
                  REPLACE: Add actual photo of Ebele
                  Replace the placeholder below with: <img src="/images/graduate-ebele.jpg" alt="Ebele Egbuna" class="w-44 h-44 rounded-3xl object-cover shadow-lg shadow-amber-500/20" />
                -->
                <div class="w-44 h-44 rounded-3xl bg-gradient-to-br from-amber-500 to-emerald-500 flex items-center justify-center shadow-lg shadow-amber-500/20">
                  <span class="font-display font-extrabold text-5xl text-ink-100">EE</span>
                </div>
                <!-- Country badge -->
                <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-violet-500/15 border border-violet-500/25 text-violet-300 text-xs font-semibold whitespace-nowrap">
                  Nigeria
                </div>
                <!-- Decorative ring -->
                <div class="absolute -inset-2 rounded-3xl border border-amber-500/20 animate-glow-pulse"></div>
              </div>

              <div class="text-center lg:text-left flex-1">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-semibold mb-4">
                  Gifted Intern 2022
                </span>
                <h3 class="font-display font-extrabold text-3xl text-ink-100 mb-2">Ebele Egbuna</h3>
                <p class="text-amber-400 font-semibold text-lg mb-1">From Intern to UI/UX Leader</p>
                <p class="text-ink-400 text-sm font-medium mb-6">Now: UI/UX Designer at Nik's Consulting</p>

                <!-- Quote -->
                <div class="relative mb-8">
                  <svg class="absolute -top-3 -left-2 w-10 h-10 text-amber-500/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                  <blockquote class="text-ink-200 leading-relaxed text-lg italic pl-8">
                    "The Gifted program didn't just teach me design — it taught me how to solve real problems for real clients. The hands-on experience was invaluable. Today, I lead UI/UX projects and mentor the next generation of Gifted interns."
                  </blockquote>
                </div>

                <!-- Skills gained -->
                <div class="flex flex-wrap gap-2.5 justify-center lg:justify-start">
                  {['UI/UX Design', 'Client Communication', 'Agile Methodology', 'Design Thinking'].map((skill, i) => {
                    const colors = ['bg-amber-500/10 border-amber-500/20 text-amber-300', 'bg-emerald-500/10 border-emerald-500/20 text-emerald-300', 'bg-brand-500/10 border-brand-500/20 text-brand-300', 'bg-violet-500/10 border-violet-500/20 text-violet-300'];
                    return (
                      <span class:list={['px-4 py-1.5 text-xs font-medium rounded-full border', colors[i % colors.length]]}>{skill}</span>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Pierre -->
        <div class="relative rounded-3xl border border-emerald-500/20 overflow-hidden group hover:border-emerald-500/40 transition-all duration-300" data-reveal="fade-up">
          <!-- Gradient mesh background -->
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/8 via-transparent to-brand-500/5"></div>
          <div class="absolute top-0 left-0 w-80 h-80 rounded-full bg-emerald-500/8 blur-[120px]"></div>
          <div class="absolute bottom-0 right-0 w-60 h-60 rounded-full bg-brand-500/6 blur-[100px]"></div>

          <div class="relative p-8 lg:p-12">
            <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start">
              <!-- Photo -->
              <div class="relative shrink-0">
                <!--
                  REPLACE: Add actual photo of Pierre
                  Replace the placeholder below with: <img src="/images/graduate-pierre.jpg" alt="Pierre Lisboa de Carvalho" class="w-44 h-44 rounded-3xl object-cover shadow-lg shadow-emerald-500/20" />
                -->
                <div class="w-44 h-44 rounded-3xl bg-gradient-to-br from-emerald-500 to-brand-500 flex items-center justify-center shadow-lg shadow-emerald-500/20">
                  <span class="font-display font-extrabold text-5xl text-ink-100">PL</span>
                </div>
                <!-- Country badge -->
                <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/25 text-emerald-300 text-xs font-semibold whitespace-nowrap">
                  Brazil
                </div>
                <!-- Decorative ring -->
                <div class="absolute -inset-2 rounded-3xl border border-emerald-500/20 animate-glow-pulse"></div>
              </div>

              <div class="text-center lg:text-left flex-1">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-semibold mb-4">
                  Gifted Intern 2021
                </span>
                <h3 class="font-display font-extrabold text-3xl text-ink-100 mb-2">Pierre Lisboa de Carvalho</h3>
                <p class="text-emerald-400 font-semibold text-lg mb-1">From Intern to DX Officer</p>
                <p class="text-ink-400 text-sm font-medium mb-6">Now: DX Officer & Automation Engineer at Nik's Consulting</p>

                <!-- Quote -->
                <div class="relative mb-8">
                  <svg class="absolute -top-3 -left-2 w-10 h-10 text-emerald-500/20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                  <blockquote class="text-ink-200 leading-relaxed text-lg italic pl-8">
                    "Working on real projects from day one accelerated my growth beyond what any classroom could. The Gifted program gave me the confidence and skills to lead digital transformation initiatives across multiple countries."
                  </blockquote>
                </div>

                <!-- Skills gained -->
                <div class="flex flex-wrap gap-2.5 justify-center lg:justify-start">
                  {['Digital Transformation', 'AI Automation', 'Project Management', 'Client Relations'].map((skill, i) => {
                    const colors = ['bg-emerald-500/10 border-emerald-500/20 text-emerald-300', 'bg-brand-500/10 border-brand-500/20 text-brand-300', 'bg-amber-500/10 border-amber-500/20 text-amber-300', 'bg-violet-500/10 border-violet-500/20 text-violet-300'];
                    return (
                      <span class:list={['px-4 py-1.5 text-xs font-medium rounded-full border', colors[i % colors.length]]}>{skill}</span>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Curved divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0C720 100 1440 0 1440 0L1440 100L0 100Z" fill="#0f0f13"/>
    </svg>
  </div>

  <!-- Video Testimonials -->
  <section class="pb-20 lg:pb-28 bg-surface-1 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.06),transparent_60%)]"></div>
    <div class="container-custom relative">
      <SectionHeading
        title="Hear from Our Graduates"
        subtitle="Watch how the Gifted program transformed their careers."
      />

      <!--
        REPLACE: Add YouTube embed URLs below.
        For each video card, replace the placeholder thumbnail div with an iframe:
        <iframe src="YOUTUBE_EMBED_URL" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { name: 'Ebele Egbuna', country: 'Nigeria', year: '2022', color: 'from-amber-500 to-orange-500' },
          { name: 'Pierre Lisboa', country: 'Brazil', year: '2021', color: 'from-emerald-500 to-teal-500' },
          { name: 'Graduate Name', country: 'Country', year: 'Year', color: 'from-brand-500 to-cyan-500' },
          { name: 'Graduate Name', country: 'Country', year: 'Year', color: 'from-violet-500 to-purple-500' },
        ].map((video, i) => (
          <div class="glass-card overflow-hidden group" data-reveal="fade-up" data-delay={String(i * 100)}>
            <div class="relative aspect-video bg-surface-3">
              <!--
                REPLACE: Replace the placeholder below with actual YouTube embed.
                Example: <iframe src="https://www.youtube.com/embed/VIDEO_ID" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              -->
              <div class:list={['absolute inset-0 bg-gradient-to-br opacity-30', video.color]}></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-16 h-16 rounded-full bg-amber-500/80 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-amber-500/30">
                  <svg class="w-7 h-7 text-ink-100 ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="p-4">
              <p class="font-semibold text-ink-100">{video.name}</p>
              <p class="text-sm text-ink-400">{video.country} &bull; {video.year}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-center text-ink-500 text-sm mt-6">
