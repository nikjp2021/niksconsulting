---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
---

<BaseLayout title="Request a Quote | Nik's Consulting" description="Request a free quote for your AI project. Tell us about your business needs and we'll create a tailored proposal with timeline and pricing.">
  <!-- Hero -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(6,182,212,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(139,92,246,0.1),transparent_50%)]"></div>
    <!-- Decorative orbs -->
    <div class="absolute top-20 right-[12%] w-80 h-80 rounded-full bg-cyan-500/8 blur-[120px] animate-glow-pulse"></div>
    <div class="absolute bottom-10 left-[18%] w-64 h-64 rounded-full bg-violet-500/8 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <!-- Decorative shapes -->
    <svg class="absolute top-16 left-[20%] w-12 h-12 text-cyan-500/10 animate-float" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="32,8 56,48 8,48"/></svg>
    <svg class="absolute bottom-20 right-[25%] w-10 h-10 text-violet-500/10 animate-float" style="animation-delay: 2.5s;" viewBox="0 0 64 64" fill="currentColor"><rect x="16" y="16" width="32" height="32" rx="8"/></svg>
    <!-- Hero illustration background -->
    <img src="/images/hero-quote.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />

    <div class="relative container-custom section-padding !py-0 text-center">
      <span class="badge-brand mb-6 inline-flex">Free Quote</span>
      <h1 class="heading-display text-5xl sm:text-6xl lg:text-7xl text-ink-100 mb-8">
        Get a <span class="gradient-text">Free Quote</span>
      </h1>
      <p class="text-xl text-ink-300 max-w-3xl mx-auto leading-relaxed">
        Tell us about your project and we'll create a <span class="text-ink-100 font-medium">tailored AI-powered proposal</span> with pricing within 24 hours.
      </p>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0L1440 80L1440 100L0 100Z" fill="#09090b"/>
    </svg>
  </div>

  <!-- Quote Form -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(6,182,212,0.04),transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(139,92,246,0.04),transparent_50%)]"></div>
    <div class="container-custom relative">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Form -->
        <div class="lg:col-span-2">
          <div class="relative rounded-3xl border border-brand-500/20 overflow-hidden">
            <!-- Gradient mesh background -->
            <div class="absolute inset-0 bg-gradient-to-br from-brand-500/[0.03] via-transparent to-violet-500/[0.03]"></div>
            <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-brand-500/6 blur-[120px]"></div>
            <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-violet-500/4 blur-[120px]"></div>

            <div class="relative p-8 lg:p-12">
              <!--
                REPLACE: Freshsales Lead Capture Form
                Replace the form below with your actual Freshsales web form embed.
                This form should have more fields than the contact form to capture project details.
              -->
              <form id="quote-form" class="space-y-10">
                <!-- Personal Info -->
                <div>
                  <div class="flex items-center gap-4 mb-6">
                    <span class="w-10 h-10 rounded-xl bg-brand-500/15 flex items-center justify-center text-brand-400 text-sm font-bold">1</span>
                    <h3 class="font-display font-bold text-xl text-ink-100">Your Information</h3>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label for="q_first_name" class="block text-sm font-semibold text-ink-200 mb-2.5">First Name *</label>
                      <input type="text" id="q_first_name" name="first_name" required class="input-field" placeholder="John" />
                    </div>
                    <div>
                      <label for="q_last_name" class="block text-sm font-semibold text-ink-200 mb-2.5">Last Name *</label>
                      <input type="text" id="q_last_name" name="last_name" required class="input-field" placeholder="Doe" />
                    </div>
                    <div>
                      <label for="q_email" class="block text-sm font-semibold text-ink-200 mb-2.5">Email *</label>
                      <input type="email" id="q_email" name="email" required class="input-field" placeholder="john@example.com" />
                    </div>
                    <div>
                      <label for="q_phone" class="block text-sm font-semibold text-ink-200 mb-2.5">Phone</label>
                      <input type="tel" id="q_phone" name="phone" class="input-field" placeholder="+1 (234) 567-890" />
                    </div>
                  </div>
                </div>

                <!-- Divider -->
                <div class="border-t border-surface-4/50"></div>

                <!-- Business Info -->
                <div>
                  <div class="flex items-center gap-4 mb-6">
                    <span class="w-10 h-10 rounded-xl bg-violet-500/15 flex items-center justify-center text-violet-400 text-sm font-bold">2</span>
                    <h3 class="font-display font-bold text-xl text-ink-100">Your Business</h3>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label for="q_company" class="block text-sm font-semibold text-ink-200 mb-2.5">Company Name</label>
                      <input type="text" id="q_company" name="company" class="input-field" placeholder="Acme Inc." />
                    </div>
                    <div>
                      <label for="q_website" class="block text-sm font-semibold text-ink-200 mb-2.5">Current Website</label>
                      <input type="url" id="q_website" name="website" class="input-field" placeholder="https://example.com" />
                    </div>
                    <div>
                      <label for="q_industry" class="block text-sm font-semibold text-ink-200 mb-2.5">Industry</label>
                      <input type="text" id="q_industry" name="industry" class="input-field" placeholder="e.g., Retail, Healthcare, Finance" />
                    </div>
                    <div>
                      <label for="q_location" class="block text-sm font-semibold text-ink-200 mb-2.5">Location</label>
                      <input type="text" id="q_location" name="location" class="input-field" placeholder="City, Country" />
                    </div>
                  </div>
                </div>

                <!-- Divider -->
                <div class="border-t border-surface-4/50"></div>

                <!-- Project Details -->
                <div>
                  <div class="flex items-center gap-4 mb-6">
                    <span class="w-10 h-10 rounded-xl bg-emerald-500/15 flex items-center justify-center text-emerald-400 text-sm font-bold">3</span>
                    <h3 class="font-display font-bold text-xl text-ink-100">Project Details</h3>
                  </div>
                  <div class="space-y-5">
                    <div>
                      <label for="q_service" class="block text-sm font-semibold text-ink-200 mb-2.5">Service Needed *</label>
                      <select id="q_service" name="service" required class="input-field">
                        <option value="">Select a service...</option>
                        {services.map((s) => (
                          <option value={s.id}>{s.title}</option>
                        ))}
                        <option value="multiple">Multiple Services</option>
                      </select>
                    </div>
                    <div>
                      <label for="q_budget" class="block text-sm font-semibold text-ink-200 mb-2.5">Estimated Budget</label>
                      <select id="q_budget" name="budget" class="input-field">
                        <option value="">Select budget range...</option>
                        <option value="under-500">Under $500</option>
                        <option value="500-1000">$500 - $1,000</option>
                        <option value="1000-2500">$1,000 - $2,500</option>
                        <option value="2500-5000">$2,500 - $5,000</option>
                        <option value="5000-plus">$5,000+</option>
                        <option value="not-sure">Not sure yet</option>
                      </select>
                    </div>
                    <div>
                      <label for="q_timeline" class="block text-sm font-semibold text-ink-200 mb-2.5">Preferred Timeline</label>
                      <select id="q_timeline" name="timeline" class="input-field">
                        <option value="">Select timeline...</option>
                        <option value="asap">ASAP</option>
                        <option value="1-month">Within 1 month</option>
                        <option value="1-3-months">1-3 months</option>
                        <option value="3-6-months">3-6 months</option>
                        <option value="flexible">Flexible</option>
                      </select>
                    </div>
                    <div>
                      <label for="q_description" class="block text-sm font-semibold text-ink-200 mb-2.5">Project Description *</label>
                      <textarea
                        id="q_description"
                        name="description"
                        rows="5"
                        required
                        class="input-field resize-none"
                        placeholder="Tell us about your project goals, challenges, and any specific requirements..."
                      ></textarea>
                    </div>
                  </div>
                </div>

                <button type="submit" class="btn-primary w-full text-lg py-5">
                  Submit Quote Request
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                </button>
              </form>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- What to Expect -->
          <div class="relative rounded-2xl border border-cyan-500/20 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent"></div>
            <div class="absolute -top-20 -right-20 w-48 h-48 rounded-full bg-cyan-500/8 blur-[60px]"></div>
            <div class="relative p-8">
              <h3 class="font-display font-bold text-xl text-ink-100 mb-6">What Happens Next?</h3>
              <div class="space-y-5">
                {[
                  { step: '01', title: 'Review', desc: 'We review your project details within 24 hours.', color: 'text-brand-400 bg-brand-500/15' },
                  { step: '02', title: 'Consultation', desc: 'We schedule a free call to discuss your needs.', color: 'text-violet-400 bg-violet-500/15' },
                  { step: '03', title: 'Proposal', desc: 'You receive a detailed proposal with pricing.', color: 'text-amber-400 bg-amber-500/15' },
                  { step: '04', title: 'Kickoff', desc: 'Once approved, we begin your project immediately.', color: 'text-emerald-400 bg-emerald-500/15' },
                ].map((item) => (
                  <div class="flex gap-4">
                    <span class:list={['font-display font-bold text-xs w-8 h-8 rounded-lg flex items-center justify-center shrink-0', item.color]}>
                      {item.step}
                    </span>
                    <div>
                      <p class="text-sm font-bold text-ink-100">{item.title}</p>
                      <p class="text-xs text-ink-400 mt-0.5">{item.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Quick Contact -->
          <div class="relative rounded-2xl border border-amber-500/20 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent"></div>
            <div class="absolute -bottom-20 -left-20 w-48 h-48 rounded-full bg-amber-500/8 blur-[60px]"></div>
            <div class="relative p-8">
              <h3 class="font-display font-bold text-xl text-ink-100 mb-4">Prefer to Talk?</h3>
              <p class="text-sm text-ink-400 mb-6">
                Book a free 30-minute consultation directly.
              </p>
              <!-- REPLACE: Your actual OnceHub link -->
              <a
                href="https://go.oncehub.com/nik4u"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline w-full text-sm mb-3"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Schedule a Call
              </a>
              <!-- REPLACE: Your actual WhatsApp number -->
              <a
                href="https://wa.me/1234567890?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20project."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost w-full text-sm text-emerald-400 hover:text-emerald-300"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Chat on WhatsApp
              </a>
            </div>
          </div>

          <!-- Trust badge -->
          <div class="relative rounded-2xl border border-emerald-500/20 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent"></div>
            <div class="relative p-8 text-center">
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/15 flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <p class="text-sm font-bold text-ink-100 mb-1">100% Satisfaction</p>
              <p class="text-xs text-ink-400">Free consultation. No obligations. We respond within 24 hours.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const quoteForm = document.getElementById('quote-form');
  quoteForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    // REPLACE: Add your Freshsales form submission logic
    alert('Thank you! We\'ve received your quote request and will respond within 24 hours with a detailed proposal.');
  });
</script>
