---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { caseStudies } from '../data/caseStudies';
import { testimonials } from '../data/testimonials';
import { stats } from '../data/stats';

const serviceIcons: Record<string, string> = {
  brain: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>',
  bot: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
  zap: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
  globe: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>',
  'share-2': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>',
  kanban: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>',
};

const serviceColors = [
  'text-violet-500 bg-violet-500/8 border-violet-500/15',
  'text-cyan-500 bg-cyan-500/8 border-cyan-500/15',
  'text-amber-500 bg-amber-500/8 border-amber-500/15',
  'text-emerald-500 bg-emerald-500/8 border-emerald-500/15',
  'text-pink-500 bg-pink-500/8 border-pink-500/15',
  'text-indigo-500 bg-indigo-500/8 border-indigo-500/15',
];
---

<BaseLayout title="Nik's Consulting v2 | Motion-First Design">
  {/* Scroll progress bar */}
  <div data-v2-progress class="fixed top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-brand-500 via-accent-cyan to-accent-violet origin-left z-[100]"></div>

  {/* ===== HERO ===== */}
  <section data-v2-hero class="relative min-h-[90vh] flex items-center overflow-hidden">
    {/* Subtle mesh background */}
    <div class="absolute inset-0 bg-surface-0"></div>
    <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse at 30% 20%, rgba(20,184,166,0.08) 0%, transparent 50%), radial-gradient(ellipse at 70% 80%, rgba(139,92,246,0.06) 0%, transparent 50%);"></div>

    <div class="relative container-custom section-padding !py-0">
      <div class="max-w-3xl">
        {/* Badge */}
        <div data-v2-badge class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-2 border border-surface-4 text-xs font-medium text-ink-300 mb-8 opacity-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          AI-First Consulting
        </div>

        {/* Heading */}
        <h1 data-v2-heading class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-ink-100 leading-[1.08] tracking-tight mb-6 opacity-0">
          We build AI solutions<br class="hidden sm:block">
          <span class="text-brand-400">that actually ship.</span>
        </h1>

        {/* Paragraph */}
        <p data-v2-paragraph class="text-lg sm:text-xl text-ink-300 leading-relaxed max-w-xl mb-10 opacity-0">
          Digital transformation for startups and SMEs. Agentic AI, automation, and lean strategies that turn complexity into growth.
        </p>

        {/* Buttons */}
        <div data-v2-buttons class="flex flex-col sm:flex-row gap-3 mb-14 opacity-0">
          <a href="/get-a-quote" data-v2-magnetic class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-ink-100 text-ink-600 font-semibold rounded-lg hover:bg-ink-200 transition-colors duration-200">
            Get a Free Quote
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/services" data-v2-magnetic class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border border-surface-4 text-ink-200 font-semibold rounded-lg hover:border-ink-400 hover:text-ink-100 transition-colors duration-200">
            Explore Services
          </a>
        </div>

        {/* Stats */}
        <div data-v2-stats class="flex flex-wrap gap-8 sm:gap-12 opacity-0">
          <div>
            <div class="font-display font-bold text-3xl sm:text-4xl text-ink-100" data-v2-counter="300" data-v2-suffix="%">0%</div>
            <div class="text-sm text-ink-400 mt-1">Average client ROI</div>
          </div>
          <div>
            <div class="font-display font-bold text-3xl sm:text-4xl text-ink-100" data-v2-counter="15" data-v2-suffix="+">0+</div>
            <div class="text-sm text-ink-400 mt-1">Countries served</div>
          </div>
          <div>
            <div class="font-display font-bold text-3xl sm:text-4xl text-ink-100" data-v2-counter="50" data-v2-suffix="+">0+</div>
            <div class="text-sm text-ink-400 mt-1">Projects delivered</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== MARQUEE ===== */}
  <div class="py-5 border-y border-surface-4/30 overflow-hidden bg-surface-1/30">
    <div class="flex animate-marquee whitespace-nowrap">
      {['AI Solutions', 'Agentic Workflows', 'Digital Transformation', 'Automation', 'Web Development', 'AI Strategy', 'Consulting', 'Growth'].map((item) => (
        <span class="mx-8 text-sm font-medium text-ink-400">{item}</span>
        <span class="mx-8 text-brand-500">/</span>
      ))}
      {['AI Solutions', 'Agentic Workflows', 'Digital Transformation', 'Automation', 'Web Development', 'AI Strategy', 'Consulting', 'Growth'].map((item) => (
        <span class="mx-8 text-sm font-medium text-ink-400">{item}</span>
        <span class="mx-8 text-brand-500">/</span>
      ))}
    </div>
  </div>

  {/* ===== SERVICES ===== */}
  <section class="section-padding bg-surface-0">
    <div class="container-custom">
      <div data-v2-reveal class="text-center mb-16">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-2 border border-surface-4 text-xs font-medium text-ink-300 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
          What We Do
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 tracking-tight mb-4">
          AI-powered services
        </h2>
        <p class="text-ink-300 text-lg max-w-xl mx-auto leading-relaxed">
          Six ways we help businesses grow with AI and digital transformation.
        </p>
      </div>

      <div data-v2-reveal class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((service, i) => (
          <a
            href={`/services#${service.id}`}
            data-v2-card
            class="group relative p-6 rounded-xl bg-surface-1 border border-surface-4/50 hover:border-surface-5 transition-all duration-300 hover:-translate-y-0.5 block"
          >
            <div class:list={['w-11 h-11 rounded-lg border flex items-center justify-center mb-4', serviceColors[i]]}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={serviceIcons[service.icon] || serviceIcons.globe} />
            </div>
            <h3 class="font-display font-semibold text-lg text-ink-100 mb-2 group-hover:text-brand-400 transition-colors">
              {service.title}
            </h3>
            <p class="text-sm text-ink-400 leading-relaxed mb-4">
              {service.shortDesc}
            </p>
            <span class="text-sm text-ink-300 group-hover:text-brand-400 transition-colors inline-flex items-center gap-1">
              Learn more
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ===== PROCESS ===== */}
  <section class="section-padding bg-surface-1/30">
    <div class="container-custom">
      <div data-v2-reveal class="text-center mb-16">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-2 border border-surface-4 text-xs font-medium text-ink-300 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-amber"></span>
          Process
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 tracking-tight mb-4">
          How we work
        </h2>
        <p class="text-ink-300 text-lg max-w-xl mx-auto leading-relaxed">
          A proven process enhanced by AI. Four steps from discovery to scale.
        </p>
      </div>

      <div data-v2-reveal class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Discover', desc: 'AI-powered research to understand your market, competition, and goals.', color: 'text-brand-400' },
          { step: '02', title: 'Strategize', desc: 'Tailored roadmap with data-driven insights and measurable KPIs.', color: 'text-accent-cyan' },
          { step: '03', title: 'Build', desc: 'Agile sprints with AI-assisted development for faster delivery.', color: 'text-accent-violet' },
          { step: '04', title: 'Scale', desc: 'AI analytics monitor performance. Continuous optimization for growth.', color: 'text-accent-amber' },
        ].map((item) => (
          <div data-v2-card class="p-6 rounded-xl bg-surface-0 border border-surface-4/30">
            <span class:list={['font-mono text-sm font-semibold mb-3 block', item.color]}>{item.step}</span>
            <h3 class="font-display font-semibold text-lg text-ink-100 mb-2">{item.title}</h3>
            <p class="text-sm text-ink-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== CASE STUDIES ===== */}
  <section class="section-padding bg-surface-0">
    <div class="container-custom">
      <div data-v2-reveal class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-2 border border-surface-4 text-xs font-medium text-ink-300 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Results
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 tracking-tight">
            Real outcomes
          </h2>
        </div>
        <a href="/case-studies" class="text-sm text-ink-300 hover:text-brand-400 transition-colors inline-flex items-center gap-1">
          View all case studies
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>

      <div data-v2-reveal class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {caseStudies.slice(0, 3).map((cs, i) => (
          <a href={`/case-studies#${cs.id}`} data-v2-card class="group rounded-xl bg-surface-1 border border-surface-4/50 overflow-hidden hover:border-surface-5 transition-all duration-300 block">
            {/* Visual area */}
            <div class="h-44 relative overflow-hidden">
              <div class:list={[
                'absolute inset-0',
                i === 0 ? 'bg-gradient-to-br from-emerald-500/15 to-teal-500/15' :
                i === 1 ? 'bg-gradient-to-br from-pink-500/15 to-rose-500/15' :
                'bg-gradient-to-br from-violet-500/15 to-purple-500/15'
              ]}></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class:list={[
                  'w-16 h-16 rounded-xl border flex items-center justify-center',
                  i === 0 ? 'bg-emerald-500/10 border-emerald-500/20' :
                  i === 1 ? 'bg-pink-500/10 border-pink-500/20' :
                  'bg-violet-500/10 border-violet-500/20'
                ]}>
                  <svg class:list={['w-7 h-7', i === 0 ? 'text-emerald-400' : i === 1 ? 'text-pink-400' : 'text-violet-400']} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
                  </svg>
                </div>
              </div>
              <div class="absolute bottom-3 left-3 flex gap-1.5">
                {cs.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 text-xs font-medium rounded bg-surface-0/80 text-ink-200 backdrop-blur-sm">{tag}</span>
                ))}
              </div>
            </div>

            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs text-ink-400">{cs.location}</span>
                <span class="w-1 h-1 rounded-full bg-surface-5"></span>
                <span class="text-xs text-ink-500">{cs.client}</span>
              </div>
              <h3 class="font-display font-semibold text-base text-ink-100 mb-2 group-hover:text-brand-400 transition-colors line-clamp-2">
                {cs.title}
              </h3>
              <div class="space-y-1.5">
                {cs.results.slice(0, 2).map((result) => (
                  <div class="flex items-start gap-2">
                    <svg class="w-3.5 h-3.5 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-xs text-ink-300">{result}</span>
                  </div>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ===== TESTIMONIALS ===== */}
  <section class="section-padding bg-surface-1/30">
    <div class="container-custom">
      <div data-v2-reveal class="text-center mb-12">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-2 border border-surface-4 text-xs font-medium text-ink-300 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-violet"></span>
          Testimonials
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 tracking-tight">
          What clients say
        </h2>
      </div>

      <div data-v2-reveal class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {testimonials.map((t, i) => (
          <div data-v2-card class="p-6 rounded-xl bg-surface-0 border border-surface-4/30">
            <div class="flex gap-1 mb-4">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-sm text-ink-200 leading-relaxed mb-5">"{t.content}"</p>
            <div class="flex items-center gap-3">
              <div class:list={[
                'w-9 h-9 rounded-full flex items-center justify-center text-white text-xs font-semibold',
                i === 0 ? 'bg-brand-500' : i === 1 ? 'bg-accent-violet' : 'bg-accent-amber'
              ]}>
                {t.name.split(' ').map((n) => n[0]).join('')}
              </div>
              <div>
                <div class="text-sm font-semibold text-ink-100">{t.name}</div>
                <div class="text-xs text-ink-400">{t.role}, {t.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="section-padding bg-surface-0">
    <div class="container-custom">
      <div data-v2-reveal class="relative rounded-2xl bg-surface-1 border border-surface-4/50 p-10 sm:p-14 lg:p-20 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-30" style="background: radial-gradient(ellipse at 50% 50%, rgba(20,184,166,0.1) 0%, transparent 60%);"></div>
        <div class="relative">
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 tracking-tight mb-5">
            Ready to build something<br class="hidden sm:block">
            <span class="text-brand-400">extraordinary?</span>
          </h2>
          <p class="text-lg text-ink-300 max-w-lg mx-auto mb-10 leading-relaxed">
            Book a free consultation. We'll show you exactly how AI can transform your operations.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/get-a-quote" data-v2-magnetic class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-ink-100 text-ink-600 font-semibold rounded-lg hover:bg-ink-200 transition-colors duration-200">
              Get a Free Quote
            </a>
            <a href="/contact" data-v2-magnetic class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-surface-4 text-ink-200 font-semibold rounded-lg hover:border-ink-400 transition-colors duration-200">
              Get in Touch
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Motion One animations */}
  <script>
    import { initMotionV2 } from '../scripts/motion-v2.js';
    initMotionV2();
  </script>
</BaseLayout>
