---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { services } from '../data/services';
import { caseStudies } from '../data/caseStudies';
import { testimonials } from '../data/testimonials';

const serviceGradients = [
  'from-violet-500 via-purple-500 to-fuchsia-500',
  'from-cyan-400 via-blue-500 to-indigo-500',
  'from-amber-400 via-orange-500 to-red-500',
  'from-emerald-400 via-teal-500 to-cyan-500',
  'from-pink-400 via-rose-500 to-red-500',
  'from-indigo-400 via-blue-500 to-cyan-500',
];

const serviceIcons: Record<string, string> = {
  brain: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>',
  bot: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
  zap: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
  globe: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>',
  'share-2': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>',
  kanban: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>',
};

const serviceGlows = [
  'hover:shadow-[0_0_40px_rgba(139,92,246,0.2)]',
  'hover:shadow-[0_0_40px_rgba(6,182,212,0.2)]',
  'hover:shadow-[0_0_40px_rgba(245,158,11,0.2)]',
  'hover:shadow-[0_0_40px_rgba(16,185,129,0.2)]',
  'hover:shadow-[0_0_40px_rgba(236,72,153,0.2)]',
  'hover:shadow-[0_0_40px_rgba(99,102,241,0.2)]',
];
---

<BaseLayout title="Niks Consulting — AI Solutions, Agentic AI & Digital Transformation">

  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-[95vh] flex items-center overflow-hidden">
    <!-- Deep background -->
    <div class="absolute inset-0 bg-surface-0"></div>
    <div class="absolute inset-0 bg-mesh-gradient opacity-80"></div>

    <!-- Animated gradient orbs -->
    <div class="absolute -top-32 -right-32 w-[700px] h-[700px] rounded-full bg-gradient-to-br from-brand-500/15 via-cyan-500/10 to-transparent blur-[140px] animate-glow-pulse"></div>
    <div class="absolute -bottom-40 -left-40 w-[600px] h-[600px] rounded-full bg-gradient-to-tr from-violet-600/12 via-fuchsia-500/8 to-transparent blur-[120px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/3 left-1/2 w-[300px] h-[300px] rounded-full bg-accent-amber/6 blur-[100px] animate-glow-pulse" style="animation-delay: 4s;"></div>

    <!-- Decorative SVG shapes -->
    <svg class="absolute top-[12%] right-[8%] w-24 h-24 text-brand-500/10 animate-float" viewBox="0 0 100 100" fill="none">
      <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="1" stroke-dasharray="6 6"/>
      <circle cx="50" cy="50" r="20" fill="currentColor" opacity="0.3"/>
    </svg>
    <svg class="absolute bottom-[18%] left-[6%] w-16 h-16 text-violet-500/15 animate-float" style="animation-delay: 3s;" viewBox="0 0 60 60" fill="none">
      <rect x="5" y="5" width="50" height="50" rx="8" stroke="currentColor" stroke-width="1.5" transform="rotate(15 30 30)"/>
    </svg>
    <svg class="absolute top-[45%] right-[5%] w-8 h-8 text-cyan-400/20 animate-float" style="animation-delay: 1.5s;" viewBox="0 0 32 32" fill="currentColor">
      <circle cx="16" cy="16" r="6"/>
    </svg>
    <svg class="absolute bottom-[30%] right-[25%] w-5 h-5 text-amber-400/25 animate-float" style="animation-delay: 4.5s;" viewBox="0 0 20 20" fill="currentColor">
      <circle cx="10" cy="10" r="4"/>
    </svg>
    <!-- Dotted line decoration -->
    <svg class="absolute top-[60%] left-[3%] w-32 h-1 text-brand-400/10" viewBox="0 0 120 4">
      <line x1="0" y1="2" x2="120" y2="2" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6"/>
    </svg>

    <!-- Hero illustration background -->
    <img src="/images/hero-home.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />

    <div class="relative container-custom section-padding !py-0">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: Content -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-surface-2/80 border border-surface-4/60 backdrop-blur-sm mb-8" data-reveal="fade-down" data-delay="0">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60 animate-ping"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
            </span>
            <span class="text-xs font-semibold text-ink-300 tracking-wider uppercase">AI-First Consulting</span>
          </div>

          <h1 class="heading-display text-4xl sm:text-5xl lg:text-[4rem] xl:text-[4.5rem] text-ink-100 mb-7 leading-[1.05]" data-reveal="fade-up" data-delay="100">
            We build<br>
            <span class="gradient-text-vibrant">AI-powered</span><br>
            solutions that<br>
            <span class="text-ink-400">actually ship.</span>
          </h1>

          <p class="text-lg lg:text-xl text-ink-400 leading-relaxed max-w-lg mb-10" data-reveal="fade-up" data-delay="200">
            Digital transformation partner for startups and SMEs. Agentic AI, automation, and lean strategies that turn complexity into growth.
          </p>

          <div class="flex flex-col sm:flex-row gap-4" data-reveal="fade-up" data-delay="300">
            <a href="/get-a-quote" class="btn-primary-glow text-base px-8 py-4">
              Get a Free Quote
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/services" class="btn-outline-glow text-base px-8 py-4">
              Explore Services
            </a>
          </div>

          <!-- Trust signals -->
          <div class="mt-14 flex flex-wrap gap-x-8 gap-y-3" data-reveal="fade-up" data-delay="400">
            {['AI-Powered', 'Global Team', '100% Satisfaction'].map((item) => (
              <div class="flex items-center gap-2.5">
                <div class="w-5 h-5 rounded-full bg-emerald-500/15 flex items-center justify-center">
                  <svg class="w-3 h-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-medium text-ink-400">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Large decorative visual -->
        <div class="hidden lg:block relative" data-reveal="scale-in" data-delay="200" data-parallax="0.15">
          <div class="relative w-full aspect-square max-w-lg mx-auto">
            <!-- Outer ring -->
            <div class="absolute inset-0 rounded-full border border-surface-4/20 animate-spin" style="animation-duration: 30s;"></div>
            <div class="absolute inset-[8%] rounded-full border border-surface-4/15 animate-spin" style="animation-duration: 24s; animation-direction: reverse;"></div>

            <!-- Central gradient blob -->
            <div class="absolute inset-[15%] rounded-full bg-gradient-to-br from-brand-500/20 via-violet-500/15 to-cyan-500/10 blur-[2px]"></div>
            <div class="absolute inset-[20%] rounded-full bg-gradient-to-tr from-brand-500/10 via-transparent to-violet-500/10 backdrop-blur-sm border border-surface-4/20"></div>

            <!-- Center icon -->
            <div class="absolute inset-[30%] flex items-center justify-center">
              <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-brand-500 to-cyan-500 flex items-center justify-center shadow-glow-lg animate-float">
                <svg class="w-12 h-12 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
            </div>

            <!-- Floating stat cards -->
            <div class="absolute -top-2 -right-6 glass-card-vibrant p-5 w-52 animate-float z-10">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center">
                  <svg class="w-4 h-4 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <span class="text-2xl font-display font-bold gradient-text-vibrant" data-count="300">0%</span>
              </div>
              <div class="text-xs text-ink-400">Avg. client ROI</div>
            </div>

            <div class="absolute -bottom-4 -left-8 glass-card-vibrant p-5 w-52 animate-float z-10" style="animation-delay: 3s;">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center">
                  <svg class="w-4 h-4 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-2xl font-display font-bold text-accent-violet">15+</span>
              </div>
              <div class="text-xs text-ink-400">Countries served</div>
            </div>

            <div class="absolute top-[15%] -left-12 glass-card-vibrant p-4 w-44 animate-float z-10" style="animation-delay: 1.5s;">
              <div class="flex items-center gap-2.5 mb-1.5">
                <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="text-xl font-display font-bold text-accent-amber">50+</span>
              </div>
              <div class="text-xs text-ink-400">Projects delivered</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE TICKER ===================== -->
  <section class="relative py-5 overflow-hidden border-y border-surface-4/30 bg-surface-1/50" data-reveal="blur-in" data-delay="0">
    <div class="marquee-track flex items-center gap-8 whitespace-nowrap">
      {[...Array(2)].map(() => (
        <div class="flex items-center gap-8 animate-marquee">
          {['AI-First Consulting', 'Digital Transformation', 'Agentic AI', 'Automation', 'Web Development', 'Social Media Strategy', 'Agile Management', 'Growth Engineering'].map((item) => (
            <span class="flex items-center gap-3 text-sm font-semibold text-ink-500 uppercase tracking-widest">
              <span class="w-2 h-2 rounded-full bg-brand-500/60"></span>
              {item}
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== INTEGRATION LOGOS ===================== -->
  <section class="py-16 bg-surface-0 relative overflow-hidden">
    <div class="absolute inset-0 bg-mesh-gradient opacity-40"></div>
    <div class="container-custom relative">
      <p class="text-center text-xs font-bold text-ink-500 uppercase tracking-[0.2em] mb-8" data-reveal="fade-up" data-delay="0">Trusted tools we integrate with</p>
      <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-5" data-stagger="true">
        {['Slack', 'WhatsApp', 'Telegram', 'Discord', 'Zapier', 'Google Workspace', 'OnceHub', 'Freshsales'].map((tool, i) => (
          <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-2/50 border border-surface-4/30 hover:border-brand-500/30 hover:bg-surface-3/50 transition-all duration-300 cursor-default group" data-reveal="fade-up">
            <span class="text-sm font-semibold text-ink-500 group-hover:text-ink-300 transition-colors">{tool}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== ANIMATED STATS ===================== -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-surface-0 via-surface-1/80 to-surface-0"></div>
    <div class="absolute inset-0 bg-mesh-gradient opacity-30"></div>

    <!-- Decorative blob -->
    <div class="absolute top-0 left-1/4 w-[500px] h-[300px] rounded-full bg-brand-500/5 blur-[100px]"></div>

    <div class="container-custom relative">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {[
          { value: 300, suffix: '%', label: 'Average Client ROI', gradient: 'from-emerald-400 to-teal-400' },
          { value: 15, suffix: '+', label: 'Countries Served', gradient: 'from-violet-400 to-fuchsia-400' },
          { value: 50, suffix: '+', label: 'Projects Delivered', gradient: 'from-cyan-400 to-blue-400' },
          { value: 10, suffix: '+', label: 'Years of Experience', gradient: 'from-amber-400 to-orange-400' },
        ].map((stat) => (
          <div class="text-center group" data-reveal="fade-up">
            <div class="inline-flex items-baseline gap-0.5 mb-2">
              <span class={`text-5xl lg:text-6xl font-display font-extrabold bg-gradient-to-r ${stat.gradient} bg-clip-text text-transparent`} data-counter={stat.value} data-suffix="">0</span>
              <span class={`text-3xl lg:text-4xl font-display font-extrabold bg-gradient-to-r ${stat.gradient} bg-clip-text text-transparent`}>{stat.suffix}</span>
            </div>
            <p class="text-sm font-medium text-ink-500 uppercase tracking-wider">{stat.label}</p>
            <div class={`w-12 h-1 mx-auto mt-3 rounded-full bg-gradient-to-r ${stat.gradient} opacity-50 group-hover:opacity-100 group-hover:w-20 transition-all duration-500`}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative h-16 -mt-16">
    <svg class="absolute bottom-0 w-full h-16 text-surface-0" viewBox="0 0 1200 64" preserveAspectRatio="none">
      <path d="M0,64 L1200,64 L1200,0 Q600,50 0,0 Z" fill="currentColor"/>
    </svg>
  </div>

  <!-- ===================== SERVICES ===================== -->
  <section class="section-padding bg-surface-0 relative overflow-hidden" id="services">
    <!-- Decorative orbs -->
    <div class="absolute -top-20 -right-40 w-[500px] h-[500px] rounded-full bg-violet-500/5 blur-[120px]"></div>
    <div class="absolute -bottom-20 -left-40 w-[400px] h-[400px] rounded-full bg-cyan-500/5 blur-[100px]"></div>

    <div class="container-custom relative">
      <SectionHeading
        tag="Services"
        title="AI-powered solutions for modern businesses"
        subtitle="From intelligent automation to full digital transformation — we deliver measurable results, not just slide decks."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-stagger="true">
        {services.map((service, i) => (
          <a
            href={`/services#${service.id}`}
            class={`group relative glass-card p-7 lg:p-8 overflow-hidden ${serviceGlows[i]} hover:-translate-y-2 transition-all duration-500 cursor-pointer block`}
            data-reveal="fade-up"
          >
            <!-- Gradient accent bar -->
            <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${serviceGradients[i]} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>

            <!-- Corner gradient glow -->
            <div class={`absolute -top-20 -right-20 w-40 h-40 rounded-full bg-gradient-to-br ${serviceGradients[i]} opacity-0 group-hover:opacity-[0.08] blur-[40px] transition-opacity duration-500`}></div>

            <!-- Icon -->
            <div class={`relative w-14 h-14 rounded-2xl bg-gradient-to-br ${serviceGradients[i]} flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 group-hover:rotate-3 transition-all duration-500`}>
              <svg class="w-7 h-7 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={serviceIcons[service.icon] || serviceIcons.globe} />
            </div>

            <!-- Content -->
            <h3 class="relative font-display font-bold text-xl text-ink-100 mb-3 group-hover:text-ink-100 transition-colors">
              {service.title}
            </h3>
            <p class="relative text-sm text-ink-400 leading-relaxed mb-6">
              {service.shortDesc}
            </p>

            <!-- Arrow -->
            <span class="relative inline-flex items-center gap-1.5 text-sm font-semibold text-ink-500 group-hover:text-ink-200 transition-colors">
              Learn more
              <svg class="w-4 h-4 group-hover:translate-x-2 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CASE STUDIES ===================== -->
  <section class="section-padding relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-surface-1/50 via-surface-1/30 to-surface-1/50"></div>
    <div class="absolute inset-0 bg-mesh-gradient opacity-30"></div>

    <!-- Decorative -->
    <div class="absolute top-20 right-10 w-20 h-20 rounded-full border border-brand-500/10 animate-spin" style="animation-duration: 20s;"></div>
    <div class="absolute bottom-20 left-10 w-12 h-12 rounded-full border border-violet-500/10 animate-spin" style="animation-duration: 15s; animation-direction: reverse;"></div>

    <div class="container-custom relative">
      <SectionHeading
        tag="Results"
        title="Real businesses, real outcomes"
        subtitle="See how AI-powered solutions have transformed operations and driven growth for our clients."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-stagger="true">
        {caseStudies.map((cs) => (
          <CaseStudyCard
            title={cs.title}
            client={cs.client}
            location={cs.location}
            challenge={cs.challenge}
            results={cs.results}
            tags={cs.tags}
            href={`/case-studies#${cs.id}`}
            reveal="scale-up"
          />
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/case-studies" class="btn-outline-glow">
          View All Case Studies
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="section-padding bg-surface-0 relative overflow-hidden">
    <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full bg-brand-500/[0.03] blur-[120px]"></div>

    <div class="container-custom relative">
      <SectionHeading
        tag="Process"
        title="How we work"
        subtitle="A proven process enhanced by AI — from discovery to deployment, we deliver faster and smarter."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" data-stagger="true">
        {[
          { step: '01', title: 'Discover', desc: 'We analyze your business, challenges, and goals. AI-powered research accelerates our understanding of your market.', color: 'from-cyan-400 to-blue-500', glow: 'rgba(6,182,212,0.15)' },
          { step: '02', title: 'Strategize', desc: 'A tailored roadmap with data-driven insights, clear milestones, and measurable KPIs for your business.', color: 'from-violet-400 to-purple-500', glow: 'rgba(139,92,246,0.15)' },
          { step: '03', title: 'Build', desc: 'Our team builds, tests, and deploys using agile sprints and AI-assisted development for faster delivery.', color: 'from-amber-400 to-orange-500', glow: 'rgba(245,158,11,0.15)' },
          { step: '04', title: 'Scale', desc: 'AI-powered analytics monitor performance. We continuously optimize and scale for sustained growth.', color: 'from-emerald-400 to-teal-500', glow: 'rgba(16,185,129,0.15)' },
        ].map((item) => (
          <div class="glass-card p-7 relative group overflow-hidden hover:-translate-y-1 transition-all duration-400" data-reveal="fade-up" style={`--glow-color: ${item.glow}`}>
            <!-- Big step number -->
            <span class={`font-mono text-7xl font-bold bg-gradient-to-br ${item.color} bg-clip-text text-transparent opacity-10 absolute -top-3 -right-1 group-hover:opacity-20 transition-opacity duration-500`}>
              {item.step}
            </span>

            <!-- Colored dot connector -->
            <div class={`w-10 h-10 rounded-xl bg-gradient-to-br ${item.color} flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300`}>
              <span class="text-sm font-mono font-bold text-ink-100">{item.step}</span>
            </div>

            <div class="relative">
              <h3 class="font-display font-bold text-lg text-ink-100 mb-3">{item.title}</h3>
              <p class="text-sm text-ink-400 leading-relaxed">{item.desc}</p>
            </div>

            <!-- Bottom glow on hover -->
            <div class={`absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t ${item.color} opacity-0 group-hover:opacity-[0.03] transition-opacity duration-500`}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <section class="section-padding relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-surface-1/40 via-surface-0 to-surface-1/40"></div>
    <div class="absolute inset-0 bg-mesh-gradient opacity-25"></div>

    <!-- Decorative blobs -->
    <div class="absolute -top-32 left-[20%] w-[400px] h-[400px] rounded-full bg-violet-500/[0.04] blur-[100px]"></div>
    <div class="absolute -bottom-32 right-[20%] w-[300px] h-[300px] rounded-full bg-brand-500/[0.04] blur-[80px]"></div>

    <div class="container-custom relative">
      <SectionHeading
        tag="Testimonials"
        title="What our clients say"
        subtitle="Don't just take our word for it — hear from the businesses we've helped transform."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger="true">
        {testimonials.map((t, i) => {
          const accents = [
            { gradient: 'from-brand-500 to-cyan-500', glow: 'brand-500' },
            { gradient: 'from-violet-500 to-fuchsia-500', glow: 'violet-500' },
            { gradient: 'from-amber-500 to-orange-500', glow: 'amber-500' },
          ];
          const accent = accents[i % 3];
          return (
            <div class="glass-card p-7 lg:p-8 relative overflow-hidden group hover:-translate-y-1 transition-all duration-400" data-reveal="fade-up">
              <!-- Large decorative quote -->
              <div class={`absolute -top-4 -left-2 text-[120px] leading-none font-display font-black bg-gradient-to-br ${accent.gradient} bg-clip-text text-transparent opacity-[0.06] select-none pointer-events-none`}>"</div>

              <!-- Top accent line -->
              <div class={`absolute top-0 left-0 w-16 h-1 bg-gradient-to-r ${accent.gradient} rounded-full`}></div>

              <!-- Stars -->
              <div class="flex gap-1 mb-5 relative">
                {Array.from({ length: t.rating }).map(() => (
                  <svg class="w-5 h-5 text-amber-400 drop-shadow-[0_0_4px_rgba(251,191,36,0.4)]" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>

              <!-- Quote -->
              <blockquote class="relative mb-7">
                <p class="text-ink-200 leading-relaxed text-[15px]">{t.content}</p>
              </blockquote>

              <!-- Author -->
              <div class="flex items-center gap-3 relative">
                <div class={`w-11 h-11 rounded-full bg-gradient-to-br ${accent.gradient} flex items-center justify-center text-ink-100 font-bold text-sm shadow-lg`}>
                  {t.name.split(' ').map((n) => n[0]).join('')}
                </div>
                <div>
                  <p class="text-sm font-bold text-ink-100">{t.name}</p>
                  <p class="text-xs text-ink-500">{t.role}, {t.company}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative py-28 overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-surface-2 via-surface-1 to-surface-2"></div>
    <div class="absolute inset-0 bg-mesh-gradient"></div>

    <!-- Large decorative orbs -->
    <div class="absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full bg-brand-500/10 blur-[150px] animate-glow-pulse"></div>
    <div class="absolute -bottom-40 -right-40 w-[600px] h-[600px] rounded-full bg-violet-500/10 blur-[150px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full bg-cyan-500/5 blur-[100px]"></div>

    <!-- Decorative shapes -->
    <svg class="absolute top-[15%] left-[10%] w-20 h-20 text-brand-500/10 animate-float" viewBox="0 0 80 80" fill="none">
      <circle cx="40" cy="40" r="38" stroke="currentColor" stroke-width="1" stroke-dasharray="8 6"/>
    </svg>
    <svg class="absolute bottom-[15%] right-[10%] w-16 h-16 text-violet-500/10 animate-float" style="animation-delay: 2s;" viewBox="0 0 60 60" fill="none">
      <rect x="5" y="5" width="50" height="50" rx="6" stroke="currentColor" stroke-width="1.5" transform="rotate(20 30 30)"/>
    </svg>
    <svg class="absolute top-[30%] right-[20%] w-6 h-6 text-cyan-400/15" viewBox="0 0 24 24" fill="currentColor">
      <circle cx="12" cy="12" r="5"/>
    </svg>

    <div class="container-custom relative text-center px-5 sm:px-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-3/80 border border-surface-4/60 backdrop-blur-sm mb-8" data-reveal="fade-down" data-delay="0">
        <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="text-xs font-semibold text-ink-300 tracking-wider uppercase">Start your transformation</span>
      </div>

      <h2 class="heading-display text-3xl sm:text-4xl lg:text-6xl text-ink-100 mb-6" data-reveal="fade-up" data-delay="100">
        Ready to build something<br>
        <span class="gradient-text-vibrant">extraordinary?</span>
      </h2>

      <p class="text-lg lg:text-xl text-ink-400 max-w-2xl mx-auto mb-12" data-reveal="fade-up" data-delay="200">
        Book a free consultation. We'll show you exactly how AI can transform your operations and accelerate growth.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center" data-reveal="fade-up" data-delay="300">
        <a href="/get-a-quote" class="btn-primary-glow text-base px-10 py-4.5">
          Get a Free Quote
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/contact" class="btn-outline-glow text-base px-10 py-4.5">
          Get in Touch
        </a>
      </div>

      <!-- Trust line -->
      <div class="mt-12 flex flex-wrap justify-center gap-x-8 gap-y-3" data-reveal="fade-up" data-delay="400">
        {['Free consultation', 'No commitment', 'Response within 24h'].map((item) => (
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span class="text-sm text-ink-500">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Animation system loaded via BaseLayout -->
</BaseLayout>
