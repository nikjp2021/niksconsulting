---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { caseStudies } from '../data/caseStudies';
---

<BaseLayout title="Case Studies — Niks Consulting" description="Real results for real businesses. See how we've helped clients achieve their digital transformation goals.">
  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(6,182,212,0.1),transparent_60%)]"></div>
    <div class="relative container-custom section-padding !py-0 text-center">
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-white mb-6">
        Case <span class="gradient-text">Studies</span>
      </h1>
      <p class="text-lg text-dark-300 max-w-2xl mx-auto">
        Real projects, real results. Explore how we've helped businesses across the globe transform their digital presence.
      </p>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="section-padding bg-dark-900">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {caseStudies.map((cs) => (
          <div id={cs.id} class="glass-card overflow-hidden scroll-mt-24">
            <!-- Image Placeholder -->
            <div class="h-56 bg-gradient-to-br from-primary-500/20 to-accent-500/20 relative">
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="w-20 h-20 text-primary-400/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <!-- REPLACE: <img src={cs.image} alt={cs.title} class="w-full h-full object-cover" /> -->
              <div class="absolute top-4 left-4 flex gap-2">
                {cs.tags.map((tag) => (
                  <span class="px-3 py-1 bg-dark-900/80 backdrop-blur-sm rounded-full text-xs text-primary-300 font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="p-8">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-sm text-accent-400 font-medium">{cs.location}</span>
                <span class="w-1 h-1 bg-dark-600 rounded-full"></span>
                <span class="text-sm text-dark-500">{cs.client}</span>
                <span class="w-1 h-1 bg-dark-600 rounded-full"></span>
                <span class="text-sm text-dark-500">{cs.category}</span>
              </div>

              <h2 class="font-display font-bold text-2xl text-white mb-4">{cs.title}</h2>

              <div class="space-y-4 mb-6">
                <div>
                  <h4 class="text-sm font-semibold text-primary-400 uppercase tracking-wider mb-2">Challenge</h4>
                  <p class="text-dark-300 leading-relaxed">{cs.challenge}</p>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-accent-400 uppercase tracking-wider mb-2">Solution</h4>
                  <p class="text-dark-300 leading-relaxed">{cs.solution}</p>
                </div>
              </div>

              <div>
                <h4 class="text-sm font-semibold text-emerald-400 uppercase tracking-wider mb-3">Results</h4>
                <div class="space-y-2">
                  {cs.results.map((result) => (
                    <div class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-emerald-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span class="text-dark-200 text-sm">{result}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-dark-800/30 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.08),transparent_70%)]"></div>
    <div class="container-custom relative text-center">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-6">
        Want to Be Our Next Success Story?
      </h2>
      <p class="text-lg text-dark-300 max-w-xl mx-auto mb-10">
        Let's discuss your project and create a tailored strategy for your business.
      </p>
      <a href="/get-a-quote" class="btn-primary text-base px-8 py-4">
        Start Your Project
      </a>
    </div>
  </section>
</BaseLayout>
