---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { caseStudies } from '../data/caseStudies';

const caseColors = [
  { gradient: 'from-brand-500 to-cyan-500', bg: 'bg-brand-500/10', border: 'border-brand-500/20', text: 'text-brand-400', orb: 'rgba(20,184,166,0.12)', tagBg: 'bg-brand-500/15 text-brand-300 border-brand-500/20' },
  { gradient: 'from-violet-500 to-purple-600', bg: 'bg-violet-500/10', border: 'border-violet-500/20', text: 'text-violet-400', orb: 'rgba(139,92,246,0.12)', tagBg: 'bg-violet-500/15 text-violet-300 border-violet-500/20' },
  { gradient: 'from-amber-500 to-orange-500', bg: 'bg-amber-500/10', border: 'border-amber-500/20', text: 'text-amber-400', orb: 'rgba(245,158,11,0.12)', tagBg: 'bg-amber-500/15 text-amber-300 border-amber-500/20' },
  { gradient: 'from-emerald-500 to-teal-500', bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', text: 'text-emerald-400', orb: 'rgba(16,185,129,0.12)', tagBg: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/20' },
  { gradient: 'from-pink-500 to-rose-500', bg: 'bg-pink-500/10', border: 'border-pink-500/20', text: 'text-pink-400', orb: 'rgba(236,72,153,0.12)', tagBg: 'bg-pink-500/15 text-pink-300 border-pink-500/20' },
  { gradient: 'from-indigo-500 to-blue-500', bg: 'bg-indigo-500/10', border: 'border-indigo-500/20', text: 'text-indigo-400', orb: 'rgba(99,102,241,0.12)', tagBg: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/20' },
];

const sectionColors = [
  { label: 'Challenge', color: 'text-brand-400', dot: 'bg-brand-400' },
  { label: 'Solution', color: 'text-violet-400', dot: 'bg-violet-400' },
  { label: 'Results', color: 'text-emerald-400', dot: 'bg-emerald-400' },
];
---

<BaseLayout title="Client Results & Case Studies | Nik's Consulting" description="See how Nik's Consulting delivered real results: 300% online orders, 70% wait time reduction, $1.5M funding secured. 6 case studies from 5 countries.">
  <!-- Hero -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(6,182,212,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(139,92,246,0.08),transparent_50%)]"></div>
    <!-- Decorative orbs -->
    <div class="absolute top-24 left-[12%] w-72 h-72 rounded-full bg-cyan-500/8 blur-[100px] animate-glow-pulse"></div>
    <div class="absolute bottom-10 right-[18%] w-64 h-64 rounded-full bg-violet-500/8 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <!-- Decorative shapes -->
    <svg class="absolute top-20 right-[22%] w-12 h-12 text-cyan-500/10 animate-float" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="8" y="8" width="48" height="48" rx="12"/></svg>
    <svg class="absolute bottom-16 left-[20%] w-10 h-10 text-violet-500/10 animate-float" style="animation-delay: 3s;" viewBox="0 0 64 64" fill="currentColor"><circle cx="32" cy="32" r="8"/></svg>
    <!-- Hero illustration background -->
    <img src="/images/hero-case-studies.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />

    <div class="relative container-custom section-padding !py-0 text-center">
      <span class="badge-brand mb-6 inline-flex">Portfolio</span>
      <h1 class="heading-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-ink-100 mb-8">
        Case <span class="gradient-text">Studies</span>
      </h1>
      <p class="text-xl text-ink-300 max-w-3xl mx-auto leading-relaxed">
        Real projects, <span class="text-ink-100 font-medium">real results</span>. Explore how we've helped businesses across the globe transform their digital presence.
      </p>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0L1440 80L1440 100L0 100Z" fill="var(--color-surface-0)"/>
    </svg>
  </div>

  <!-- Case Studies Grid -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        {caseStudies.map((cs, index) => {
          const color = caseColors[index % caseColors.length];
          return (
            <div id={cs.id} class:list={['relative rounded-3xl border overflow-hidden scroll-mt-24 group hover:-translate-y-1 transition-all duration-300', color.border]}>
              <!-- Gradient mesh background -->
              <div class:list={['absolute inset-0 bg-gradient-to-br opacity-[0.04]', color.gradient]}></div>
              <div class:list={['absolute -top-32 -right-32 w-80 h-80 rounded-full blur-[100px] opacity-30']} style={`background: ${color.orb};`}></div>

              <!-- Image Placeholder -->
              <div class:list={['h-56 relative overflow-hidden bg-gradient-to-br', color.gradient, 'opacity-20']}>
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-24 h-24 text-ink-100/10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
                <!-- REPLACE: <img src={cs.image} alt={cs.title} class="w-full h-full object-cover" /> -->
                <div class="absolute top-5 left-5 flex gap-2.5">
                  {cs.tags.map((tag) => (
                    <span class:list={['px-3.5 py-1.5 backdrop-blur-sm rounded-full text-xs font-semibold border', color.tagBg]}>
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="relative p-8 lg:p-10">
                <div class="flex flex-wrap items-center gap-3 mb-5">
                  <span class:list={['text-sm font-semibold', color.text]}>{cs.location}</span>
                  <span class="w-1 h-1 bg-surface-5 rounded-full"></span>
                  <span class="text-sm text-ink-400">{cs.client}</span>
                  <span class="w-1 h-1 bg-surface-5 rounded-full"></span>
                  <span class="text-sm text-ink-400">{cs.category}</span>
                </div>

                <h2 class="font-display font-extrabold text-2xl lg:text-3xl text-ink-100 mb-6 leading-tight">{cs.title}</h2>

                <div class="space-y-5 mb-8">
                  <div>
                    <div class="flex items-center gap-2 mb-3">
                      <div class="w-1.5 h-1.5 rounded-full bg-brand-400"></div>
                      <h4 class="text-xs font-bold text-brand-400 uppercase tracking-widest">Challenge</h4>
                    </div>
                    <p class="text-ink-300 leading-relaxed">{cs.challenge}</p>
                  </div>
                  <div>
                    <div class="flex items-center gap-2 mb-3">
                      <div class="w-1.5 h-1.5 rounded-full bg-violet-400"></div>
                      <h4 class="text-xs font-bold text-violet-400 uppercase tracking-widest">Solution</h4>
                    </div>
                    <p class="text-ink-300 leading-relaxed">{cs.solution}</p>
                  </div>
                </div>

                <div>
                  <div class="flex items-center gap-2 mb-4">
                    <div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div>
                    <h4 class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Results</h4>
                  </div>
                  <div class="space-y-3">
                    {cs.results.map((result) => (
                      <div class="flex items-start gap-3 p-3 rounded-xl bg-emerald-500/5 border border-emerald-500/10">
                        <svg class="w-5 h-5 text-emerald-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-ink-200 text-sm font-medium">{result}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA with curved top -->
  <section class="relative overflow-hidden">
    <svg class="w-full h-20 lg:h-28 -mb-1" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 100L1440 20L1440 0L0 0Z" fill="var(--color-surface-0)"/>
    </svg>
    <div class="bg-surface-1 pb-24 lg:pb-32 relative">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(6,182,212,0.08),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(139,92,246,0.06),transparent_50%)]"></div>
      <!-- Floating orbs -->
      <div class="absolute top-0 right-[25%] w-60 h-60 rounded-full bg-cyan-500/6 blur-[100px] animate-glow-pulse"></div>
      <div class="absolute bottom-0 left-[25%] w-60 h-60 rounded-full bg-violet-500/6 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>

      <div class="container-custom relative text-center section-padding !py-0">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          Success Stories
        </span>
        <h2 class="heading-display text-4xl sm:text-5xl lg:text-6xl text-ink-100 mb-8">
          Want to Be Our Next <span class="gradient-text">Success Story</span>?
        </h2>
        <p class="text-xl text-ink-300 max-w-2xl mx-auto mb-12 leading-relaxed">
          Let's discuss your project and create a tailored strategy for your business.
        </p>
        <a href="/get-a-quote" class="btn-primary text-lg px-10 py-5">
          Start Your Project
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
