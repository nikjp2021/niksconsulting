---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { services } from '../data/services';
---

<BaseLayout title="Services — Niks Consulting">
  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.1),transparent_60%)]"></div>
    <div class="relative container-custom section-padding !py-0 text-center">
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-white mb-6">
        Our <span class="gradient-text">Services</span>
      </h1>
      <p class="text-lg text-dark-300 max-w-2xl mx-auto">
        AI-powered solutions and digital transformation services designed to revolutionize your business, from agentic AI to intelligent automation.
      </p>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="section-padding bg-dark-900">
    <div class="container-custom space-y-20">
      {services.map((service, index) => (
        <div
          id={service.id}
          class:list={[
            'grid grid-cols-1 lg:grid-cols-2 gap-12 items-center scroll-mt-24',
            index % 2 === 1 && 'lg:flex-row-reverse',
          ]}
        >
          {/* Content */}
          <div class:list={[index % 2 === 1 && 'lg:order-2']}>
            <div class:list={['w-14 h-14 rounded-2xl bg-gradient-to-br flex items-center justify-center mb-6', service.color]}>
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                {service.icon === 'globe' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>}
                {service.icon === 'brain' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>}
                {service.icon === 'bot' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>}
                {service.icon === 'zap' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>}
                {service.icon === 'code' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>}
                {service.icon === 'share-2' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>}
                {service.icon === 'trending-up' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>}
                {service.icon === 'kanban' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>}
                {service.icon === 'blocks' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>}
              </svg>
            </div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-4">
              {service.title}
            </h2>
            <p class="text-dark-300 text-lg leading-relaxed mb-8">
              {service.description}
            </p>
            <ul class="space-y-3 mb-8">
              {service.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-primary-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-dark-200">{feature}</span>
                </li>
              ))}
            </ul>
            <a href="/get-a-quote" class="btn-primary">
              Get Started
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>

          {/* Visual Card */}
          <div class:list={[index % 2 === 1 && 'lg:order-1']}>
            <div class:list={['glass-card p-8 lg:p-12 relative overflow-hidden']}>
              <div class:list={['absolute inset-0 opacity-10 bg-gradient-to-br', service.color]}></div>
              <div class="relative">
                <div class:list={['w-20 h-20 rounded-2xl bg-gradient-to-br flex items-center justify-center mb-8', service.color]}>
                  <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    {service.icon === 'globe' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>}
                    {service.icon === 'brain' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>}
                    {service.icon === 'bot' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>}
                    {service.icon === 'zap' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>}
                    {service.icon === 'code' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>}
                    {service.icon === 'share-2' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>}
                    {service.icon === 'trending-up' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>}
                    {service.icon === 'kanban' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>}
                    {service.icon === 'blocks' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>}
                  </svg>
                </div>
                <h3 class="font-display font-semibold text-2xl text-white mb-4">
                  Why Choose Us for {service.title}?
                </h3>
                <div class="space-y-4">
                  {service.features.slice(0, 4).map((f, i) => (
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-lg bg-primary-500/20 flex items-center justify-center text-primary-400 text-sm font-bold shrink-0">
                        {String(i + 1).padStart(2, '0')}
                      </div>
                      <span class="text-dark-200 text-sm">{f}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-dark-800/30 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.08),transparent_70%)]"></div>
    <div class="container-custom relative text-center">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-6">
        Not Sure Which Service You Need?
      </h2>
      <p class="text-lg text-dark-300 max-w-xl mx-auto mb-10">
        Book a free consultation and we'll help you identify the best solutions for your business.
      </p>
      <a href="/contact" class="btn-primary text-base px-8 py-4">
        Book a Free Consultation
      </a>
    </div>
  </section>
</BaseLayout>
