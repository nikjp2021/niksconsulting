---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { services } from '../data/services';

const serviceAccents = [
  { bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', text: 'text-emerald-400', ring: 'bg-emerald-500/20', gradient: 'from-emerald-500 to-teal-600', orb: 'rgba(16,185,129,0.12)', badge: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/20' },
  { bg: 'bg-cyan-500/10', border: 'border-cyan-500/20', text: 'text-cyan-400', ring: 'bg-cyan-500/20', gradient: 'from-cyan-500 to-blue-600', orb: 'rgba(6,182,212,0.12)', badge: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/20' },
  { bg: 'bg-amber-500/10', border: 'border-amber-500/20', text: 'text-amber-400', ring: 'bg-amber-500/20', gradient: 'from-amber-500 to-orange-600', orb: 'rgba(245,158,11,0.12)', badge: 'bg-amber-500/15 text-amber-300 border-amber-500/20' },
  { bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', text: 'text-emerald-400', ring: 'bg-emerald-500/20', gradient: 'from-emerald-500 to-teal-600', orb: 'rgba(16,185,129,0.12)', badge: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/20' },
  { bg: 'bg-pink-500/10', border: 'border-pink-500/20', text: 'text-pink-400', ring: 'bg-pink-500/20', gradient: 'from-pink-500 to-rose-600', orb: 'rgba(236,72,153,0.12)', badge: 'bg-pink-500/15 text-pink-300 border-pink-500/20' },
  { bg: 'bg-brand-500/10', border: 'border-brand-500/20', text: 'text-brand-400', ring: 'bg-brand-500/20', gradient: 'from-brand-500 to-cyan-600', orb: 'rgba(20,184,166,0.12)', badge: 'bg-brand-500/15 text-brand-300 border-brand-500/20' },
];
---

<BaseLayout title="Services — Nik's Consulting">
  <!-- Hero -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.1),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(6,182,212,0.1),transparent_50%)]"></div>
    <!-- Decorative orbs -->
    <div class="absolute top-20 left-[10%] w-72 h-72 rounded-full bg-accent-amber/8 blur-[100px] animate-glow-pulse"></div>
    <div class="absolute bottom-10 right-[15%] w-64 h-64 rounded-full bg-cyan-500/8 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>
    <!-- Decorative SVG shapes -->
    <svg class="absolute top-16 right-[20%] w-16 h-16 text-accent-amber/10 animate-float" viewBox="0 0 64 64" fill="currentColor"><circle cx="32" cy="32" r="8"/></svg>
    <svg class="absolute bottom-24 left-[25%] w-12 h-12 text-cyan-500/10 animate-float" style="animation-delay: 3s;" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><rect x="12" y="12" width="40" height="40" rx="8" transform="rotate(15 32 32)"/></svg>
    <!-- Hero illustration background -->
    <img src="/images/hero-services.svg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" loading="eager" />
    <div class="relative container-custom section-padding !py-0 text-center">
      <span class="badge-brand mb-6 inline-flex">What We Do</span>
      <h1 class="heading-display text-5xl sm:text-6xl lg:text-7xl text-ink-100 mb-8">
        Our <span class="gradient-text">Services</span>
      </h1>
      <p class="text-xl text-ink-300 max-w-3xl mx-auto leading-relaxed">
        AI-powered solutions and digital transformation services designed to <span class="text-ink-100 font-medium">revolutionize your business</span> — from agentic AI to intelligent automation.
      </p>
    </div>
  </section>

  <!-- Angled divider -->
  <div class="relative -mt-1">
    <svg class="w-full h-20 lg:h-28" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 0L1440 80L1440 100L0 100Z" fill="#09090b"/>
    </svg>
  </div>

  <!-- Services Detail -->
  <section class="pb-20 lg:pb-28 bg-surface-0 relative">
    <div class="container-custom space-y-28">
      {services.map((service, index) => {
        const accent = serviceAccents[index];
        return (
          <div
            id={service.id}
            class:list={[
              'relative scroll-mt-24',
            ]}
          >
            <!-- Decorative background orb -->
            <div class:list={[
              'absolute -top-20 w-[500px] h-[500px] rounded-full blur-[140px] opacity-30 pointer-events-none',
              index % 2 === 0 ? '-right-40' : '-left-40',
            ]} style={`background: ${accent.orb};`}></div>

            <div class:list={[
              'grid grid-cols-1 lg:grid-cols-2 gap-16 items-center',
            ]}>
              {/* Content */}
              <div class:list={[index % 2 === 1 && 'lg:order-2']}>
                <!-- Service number & badge -->
                <div class="flex items-center gap-4 mb-6">
                  <span class:list={['inline-flex items-center justify-center w-10 h-10 rounded-xl text-sm font-bold border', accent.bg, accent.border, accent.text]}>
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class:list={['inline-flex items-center px-3 py-1 text-xs font-medium rounded-full border', accent.badge]}>
                    {service.title.split(' ')[0]}
                  </span>
                </div>

                <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-100 mb-5 leading-tight">
                  {service.title}
                </h2>
                <p class="text-ink-300 text-lg leading-relaxed mb-8">
                  {service.description}
                </p>

                <!-- Features list -->
                <div class:list={['rounded-2xl border p-6 mb-8', accent.bg, accent.border]}>
                  <h4 class:list={['text-sm font-semibold uppercase tracking-wider mb-4', accent.text]}>What's Included</h4>
                  <ul class="space-y-3">
                    {service.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <svg class:list={['w-5 h-5 mt-0.5 shrink-0', accent.text]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-ink-200 text-sm">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <a href="/get-a-quote" class:list={['inline-flex items-center gap-2 px-7 py-3.5 rounded-xl font-semibold !text-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg bg-gradient-to-r', accent.gradient]}>
                  Get Started
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>

              {/* Visual Card */}
              <div class:list={[index % 2 === 1 && 'lg:order-1']}>
                <div class:list={['relative rounded-3xl overflow-hidden border', accent.border]}>
                  <!-- Gradient mesh background -->
                  <div class:list={['absolute inset-0 bg-gradient-to-br opacity-10', accent.gradient]}></div>
                  <div class:list={['absolute top-0 right-0 w-48 h-48 rounded-full blur-[80px] opacity-20', accent.bg]} style={`background: ${accent.orb};`}></div>

                  <div class="relative p-10 lg:p-14">
                    <!-- Large icon -->
                    <div class:list={['w-24 h-24 rounded-3xl bg-gradient-to-br flex items-center justify-center mb-10 shadow-lg', accent.gradient]}>
                      <svg class="w-12 h-12 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        {service.icon === 'globe' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>}
                        {service.icon === 'brain' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>}
                        {service.icon === 'bot' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>}
                        {service.icon === 'zap' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>}
                        {service.icon === 'code' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>}
                        {service.icon === 'share-2' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>}
                        {service.icon === 'trending-up' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>}
                        {service.icon === 'kanban' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>}
                        {service.icon === 'blocks' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>}
                      </svg>
                    </div>

                    <h3 class="font-display font-bold text-2xl text-ink-100 mb-8">
                      Why Choose Us for {service.title}?
                    </h3>
                    <div class="space-y-5">
                      {service.features.slice(0, 4).map((f, i) => (
                        <div class="flex items-center gap-4">
                          <div class:list={['w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold shrink-0', accent.ring, accent.text]}>
                            {String(i + 1).padStart(2, '0')}
                          </div>
                          <span class="text-ink-200">{f}</span>
                        </div>
                      ))}
                    </div>

                    <!-- Decorative dots pattern -->
                    <div class="absolute bottom-6 right-6 grid grid-cols-3 gap-2 opacity-20">
                      {[...Array(9)].map(() => (
                        <div class:list={['w-1.5 h-1.5 rounded-full', accent.bg.replace('/10', '/40')]}></div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Section divider (alternating curved) -->
            {index < services.length - 1 && (
              <div class="flex justify-center mt-20">
                <div class:list={['w-24 h-0.5 rounded-full bg-gradient-to-r', accent.gradient, 'opacity-30']}></div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- CTA Section with curved top -->
  <section class="relative overflow-hidden">
    <svg class="w-full h-20 lg:h-28 -mb-1" viewBox="0 0 1440 100" preserveAspectRatio="none" fill="none">
      <path d="M0 100L1440 20L1440 0L0 0Z" fill="#09090b"/>
    </svg>
    <div class="bg-surface-1 pb-24 lg:pb-32 relative">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.06),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(6,182,212,0.06),transparent_50%)]"></div>
      <!-- Floating orbs -->
      <div class="absolute top-0 left-[20%] w-60 h-60 rounded-full bg-accent-amber/6 blur-[100px] animate-glow-pulse"></div>
      <div class="absolute bottom-0 right-[20%] w-60 h-60 rounded-full bg-cyan-500/6 blur-[100px] animate-glow-pulse" style="animation-delay: 2s;"></div>

    {/* Case Studies hint */}
    <section class="section-padding">
      <div class="container-custom">
        <a href="/case-studies" class="group glass-card-hover p-8 flex flex-col sm:flex-row items-center gap-6 block">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center shrink-0">
            <svg class="w-8 h-8 text-ink-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
          </div>
          <div class="text-center sm:text-left flex-1">
            <h3 class="font-display font-bold text-xl text-ink-100 mb-2 group-hover:text-brand-400 transition-colors">
              See Our Work in Action
            </h3>
            <p class="text-ink-400 leading-relaxed">
              Explore 6 real case studies — from AI-powered triage in Japan to e-commerce automation in Brazil. See the results we deliver.
            </p>
          </div>
          <svg class="w-6 h-6 text-ink-400 group-hover:text-brand-400 group-hover:translate-x-1 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </section>

      <div class="container-custom relative text-center section-padding !py-0">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-300 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Free Consultation
        </span>
        <h2 class="heading-display text-4xl sm:text-5xl lg:text-6xl text-ink-100 mb-8">
          Not Sure Which <span class="gradient-text">Service</span> You Need?
        </h2>
        <p class="text-xl text-ink-300 max-w-2xl mx-auto mb-12 leading-relaxed">
          Book a free consultation and we'll help you identify the best solutions for your business.
        </p>
        <a href="/contact" class="btn-primary text-lg px-10 py-5">
          Book a Free Consultation
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
