---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { team } from '../data/team';
---

<BaseLayout title="About Us — Niks Consulting" description="Learn about Niks Consulting — our mission, story, and commitment to helping businesses thrive through digital transformation.">
  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-hero-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.15),transparent_60%)]"></div>
    <div class="relative container-custom section-padding !py-0 text-center">
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-white mb-6">
        About <span class="gradient-text">Niks Consulting</span>
      </h1>
      <p class="text-lg text-dark-300 max-w-2xl mx-auto">
        Pioneers in AI Solutions & Innovation — empowering businesses worldwide with agentic AI, automation, and digital transformation.
      </p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="section-padding bg-dark-900">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-6">
            Empowering Businesses Through AI & Technology
          </h2>
          <div class="space-y-4 text-dark-300 leading-relaxed">
            <p>
              At Niks Consulting, we believe that every business — regardless of size — deserves access to AI-powered solutions and modern digital strategy. Founded by Nikhil Tiwari, our consulting firm specializes in helping businesses navigate the complex landscape of AI, agentic workflows, and digital transformation.
            </p>
            <p>
              From building AI-powered applications and intelligent automation to crafting data-driven social media strategies and implementing agile project management, we provide end-to-end solutions that drive real business results.
            </p>
            <p>
              Our approach is simple: we listen, strategize, execute, and optimize with AI at the core. We don't just build technology — we build intelligent systems and partnerships that help your business grow.
            </p>
          </div>
          <a href="/contact" class="btn-primary mt-8">
            Get in Touch
          </a>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 gap-6">
          {[
            { number: '3', label: 'Countries Served', suffix: '+' },
            { number: '10', label: 'Projects Delivered', suffix: '+' },
            { number: '3', label: 'Years Experience', suffix: '+' },
            { number: '100', label: 'Client Satisfaction', suffix: '%' },
          ].map((stat) => (
            <div class="glass-card p-6 text-center">
              <div class="font-display font-bold text-4xl gradient-text mb-2">
                {stat.number}<span class="text-2xl">{stat.suffix}</span>
              </div>
              <p class="text-sm text-dark-400">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section-padding bg-dark-800/30">
    <div class="container-custom">
      <SectionHeading
        title="Our Mission & Vision"
        subtitle="What drives us every day."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="glass-card p-8">
          <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <h3 class="font-display font-semibold text-xl text-white mb-4">Our Vision</h3>
          <p class="text-dark-300 leading-relaxed">
            To be the trusted AI and technology partner for small and medium businesses worldwide, making cutting-edge AI solutions, agentic workflows, and digital transformation accessible and affordable. We envision a world where every business can compete in the AI-powered marketplace.
          </p>
        </div>

        <div class="glass-card p-8">
          <div class="w-12 h-12 rounded-xl bg-accent-500/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="font-display font-semibold text-xl text-white mb-4">Our Mission</h3>
          <p class="text-dark-300 leading-relaxed">
            To empower businesses with AI-powered solutions, intelligent automation, and strategic digital consulting. We combine technical expertise with business acumen to deliver agentic workflows and intelligent systems that drive growth, efficiency, and competitive advantage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Nik - Founder -->
  <section class="section-padding bg-dark-900">
    <div class="container-custom">
      <SectionHeading
        title="Meet Nik"
        subtitle="The builder behind Niks Consulting."
      />

      <div class="max-w-4xl mx-auto">
        <div class="glass-card p-8 lg:p-12 relative overflow-hidden">
          <div class="absolute inset-0 opacity-10 bg-gradient-to-br from-primary-500 to-accent-500"></div>
          <div class="relative flex flex-col md:flex-row gap-8 items-center md:items-start">
            <div class="w-32 h-32 rounded-2xl bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center shrink-0">
              <span class="font-display font-bold text-4xl text-white">NT</span>
            </div>
            <div class="text-center md:text-left">
              <h3 class="font-display font-bold text-2xl text-white mb-1">Nikhil Tiwari</h3>
              <p class="text-primary-400 font-medium mb-2">Founder & Fractional CPO</p>
              <p class="text-accent-400 text-sm font-medium mb-4">Agentic AI Builder | Xiaomi MiMo Grant Winner | PhD Candidate</p>
              <p class="text-dark-300 leading-relaxed mb-4">
                I build products with AI — not theory, working systems. 10+ years in product management. PhD candidate at Shizuoka University, Japan. I ship agentic AI systems using Claude Code, OpenCode, and autonomous workflow design. I architect AI for health tech: telehealth, remote patient monitoring, HIPAA. I publish on AI governance, algorithmic management, and ethical AI.
              </p>
              <p class="text-dark-300 leading-relaxed mb-6">
                Previously at Expedia Group ($2M budget, 3K agents). Founder of MyTegami.win (5K users, NPS 72). Won the 2026 Xiaomi MiMo Builders Grant. I'm a builder, not a developer. I use AI tools daily to prototype, automate, and ship faster than any team waiting on a sprint cycle.
              </p>
              <div class="flex flex-wrap gap-2 justify-center md:justify-start mb-6">
                {['Agentic AI', 'Health Tech', 'Product Strategy', 'LLM Systems', 'Web3', 'PhD Research'].map((tag) => (
                  <span class="px-3 py-1 text-xs font-medium rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-300">{tag}</span>
                ))}
              </div>
              <div class="flex gap-3 justify-center md:justify-start">
                <a href="https://www.linkedin.com/in/ntiwari1" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-dark-800 border border-dark-700 text-dark-300 hover:text-white hover:border-primary-500/50 transition-all text-sm">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  LinkedIn
                </a>
                <a href="https://go.oncehub.com/nik4u" target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">
                  Book a Call
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section-padding bg-dark-800/30">
    <div class="container-custom">
      <SectionHeading
        title="Our Team"
        subtitle="The people driving AI innovation and digital transformation at Niks Consulting."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {team.filter((m) => m.name !== 'Nikhil Tiwari').map((member) => (
          <div class="glass-card p-6 text-center group">
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center mx-auto mb-5">
              <span class="font-display font-bold text-xl text-white">
                {member.name.split(' ').map((n) => n[0]).join('')}
              </span>
            </div>
            <h3 class="font-display font-semibold text-lg text-white mb-1">{member.name}</h3>
            <p class="text-primary-400 text-sm font-medium mb-3">{member.role}</p>
            <p class="text-dark-400 text-sm leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section-padding bg-dark-800/30">
    <div class="container-custom">
      <SectionHeading
        title="Certifications & Expertise"
        subtitle="Backed by industry-recognized certifications and methodologies."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'AI & Agentic AI', desc: 'Expertise in building autonomous AI agents, LLM-powered workflows, and intelligent decision systems.' },
          { title: 'AI Automation', desc: 'Certified in designing and deploying AI-driven automation pipelines that streamline business operations.' },
          { title: 'Agile Scrum', desc: 'Certified Scrum Master with hands-on experience leading agile teams and delivering iterative results.' },
          { title: 'Digital Transformation', desc: 'End-to-end DX strategy from legacy modernization to AI-powered digital ecosystems.' },
          { title: 'Product Management', desc: 'End-to-end product lifecycle management from ideation to launch and growth.' },
          { title: 'Cloud & DevOps', desc: 'Experience with cloud infrastructure, CI/CD pipelines, and scalable deployment architectures.' },
        ].map((cert) => (
          <div class="glass-card p-6 text-center">
            <div class="w-12 h-12 rounded-xl bg-primary-500/10 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
              </svg>
            </div>
            <h3 class="font-display font-semibold text-lg text-white mb-2">{cert.title}</h3>
            <p class="text-sm text-dark-400 leading-relaxed">{cert.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
